<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staff Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="staff-shell">
        <aside class="staff-sidebar" aria-label="Nhân viên">
            <div class="staff-brand">
                <span class="staff-brand__mark"><i class="bi bi-cup-hot-fill"></i></span>
                <div>
                    <strong>Staff Panel</strong>
                    <small>TheDrinkVN Operations</small>
                </div>
            </div>

            <nav class="staff-nav">
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                }
                <a asp-controller="BanHang" asp-action="Index" class="@(currentController == "BanHang" ? "active" : "")">
                    <i class="bi bi-shop"></i> BÁN HÀNG (POS)
                </a>
                <a asp-controller="DonHangOnline" asp-action="Index" class="@(currentController == "DonHangOnline" ? "active" : "")">
                    <i class="bi bi-box-seam"></i> ĐƠN HÀNG ONLINE
                </a>
                <a asp-controller="StaffHoaDon" asp-action="Index" class="@(currentController == "StaffHoaDon" ? "active" : "")">
                    <i class="bi bi-receipt"></i> HÓA ĐƠN
                </a>
            </nav>

            <div class="staff-sidebar__footer">
                <a asp-controller="Auth" asp-action="Profile"><i class="bi bi-person"></i> HỒ SƠ</a>
                <a asp-controller="Auth" asp-action="ChangePassword"><i class="bi bi-gear"></i> CÀI ĐẶT</a>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"><i class="bi bi-box-arrow-left"></i> ĐĂNG XUẤT</button>
                </form>
            </div>
        </aside>

        <main class="staff-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
