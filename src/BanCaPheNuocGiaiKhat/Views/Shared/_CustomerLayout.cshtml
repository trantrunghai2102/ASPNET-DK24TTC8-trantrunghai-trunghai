<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TheDrinkVN – Artisan coffee & beverages, crafted for the true aficionado." />
    <title>@ViewData["Title"] – TheDrinkVN</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Customer Navbar -->
    <nav class="site-nav" id="site-navbar">
        <div class="site-nav__inner">
            <a asp-controller="Home" asp-action="Index" class="site-nav__brand">TheDrinkVN</a>

            <ul class="site-nav__links">
                <li><a asp-controller="SanPham" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "SanPham" ? "active" : "")">Cửa hàng</a></li>
                <li>
                    <a asp-controller="DatHang"
                       asp-action="DonHangCuaToi"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "DatHang" ? "active" : "")">
                        Đơn hàng
                    </a>
                </li>
            </ul>

            <div class="site-nav__right">
                <div class="site-nav__search">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Tìm kiếm sản phẩm..." aria-label="Search" />
                </div>

                <a asp-controller="GioHang" asp-action="Index" class="site-nav__icon-btn" aria-label="Cart" title="Giỏ hàng" style="position:relative;">
                    <i class="bi bi-bag" style="font-size:17px;"></i>
                    <span id="cartCountBadge" style="display:none; position:absolute; top: -5px; right: -8px; background: #c0392b; color: white; border-radius: 50%; padding: 0.15rem 0.35rem; font-size: 0.65rem; font-weight: bold; line-height: 1;">0</span>
                </a>

                @{
                    var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "U";
                    var initial = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "U";
                }

                <div class="nav-profile" id="nav-profile">
                    <button class="nav-profile__btn" id="nav-profile-btn" aria-expanded="false" aria-haspopup="true" title="Tài khoản của tôi">
                        <span class="nav-profile__avatar">@initial</span>
                        <i class="bi bi-chevron-down nav-profile__caret" style="font-size:12px;"></i>
                    </button>
                    <div class="nav-profile__dropdown" id="nav-profile-dropdown" role="menu">
                        <div class="nav-profile__header">
                            <span class="nav-profile__name">@displayName</span>
                            <span class="nav-profile__role">Khách hàng</span>
                        </div>
                        <a asp-controller="Auth" asp-action="Profile" class="nav-profile__item" role="menuitem">
                            <i class="bi bi-person" style="font-size:14px;"></i>
                            Hồ sơ của tôi
                        </a>
                        <a asp-controller="Auth" asp-action="ChangePassword" class="nav-profile__item" role="menuitem">
                            <i class="bi bi-lock" style="font-size:14px;"></i>
                            Đổi mật khẩu
                        </a>
                        <div class="nav-profile__divider"></div>
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="nav-profile__item nav-profile__item--danger" role="menuitem">
                                <i class="bi bi-box-arrow-right" style="font-size:14px;"></i>
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main content -->
    <main role="main" class="page-main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="site-footer__inner">
            <div>
                <div class="footer-brand">TheDrinkVN</div>
                <p class="footer-desc">Mang đến trải nghiệm cà phê tuyệt vời<br>cho những người đam mê phong cách sống hiện đại.</p>
                <p class="footer-copy">© 2026 TheDrinkVN. Mọi quyền được bảo lưu.</p>
            </div>

            <div class="footer-col">
                <h4>Cửa hàng</h4>
                <ul>
                    <li><a href="#">Cà phê hạt</a></li>
                    <li><a href="#">Cà phê bột</a></li>
                    <li><a href="#">Dụng cụ pha chế</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Hỗ trợ</h4>
                <ul>
                    <li><a href="#">Thông tin giao hàng</a></li>
                    <li><a href="#">Hoàn trả sản phẩm</a></li>
                    <li><a href="#">Liên hệ với chúng tôi</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Pháp lý</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
                    <li><a href="#">Điều khoản dịch vụ</a></li>
                </ul>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Profile dropdown toggle
        (function () {
            var btn = document.getElementById('nav-profile-btn');
            var dropdown = document.getElementById('nav-profile-dropdown');
            if (!btn || !dropdown) return;

            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var isOpen = dropdown.classList.contains('open');
                dropdown.classList.toggle('open', !isOpen);
                btn.setAttribute('aria-expanded', String(!isOpen));
            });

            document.addEventListener('click', function () {
                dropdown.classList.remove('open');
                btn.setAttribute('aria-expanded', 'false');
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    dropdown.classList.remove('open');
                    btn.setAttribute('aria-expanded', 'false');
                    btn.focus();
                }
            });
        })();

        function updateCartCount() {
            fetch('/GioHang/GetCartCount')
                .then(res => res.json())
                .then(data => {
                    var badge = document.getElementById('cartCountBadge');
                    if (data && data.count > 0) {
                        badge.textContent = data.count;
                        badge.style.display = 'inline-block';
                    } else {
                        badge.style.display = 'none';
                    }
                })
                .catch(err => console.error(err));
        }

        document.addEventListener("DOMContentLoaded", function() {
            updateCartCount();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
