<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TheDrinkVN – Artisan coffee & beverages, crafted for the true aficionado." />
    <title>@ViewData["Title"] – TheDrinkVN</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" /><
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Auth" ? "auth-page" : "")">

@{
    var isAuth = ViewContext.RouteData.Values["controller"]?.ToString() == "Auth";
}

@if (!isAuth)
{
    <!-- Promo banner -->
    <div class="promo-banner">
        FIRST ORDER 10% OFF. USE CODE <strong>ARTISAN10</strong> AT CHECKOUT.
    </div>

    <!-- Navbar -->
    <nav class="site-nav" id="site-navbar">
        <div class="site-nav__inner">
            <a asp-controller="Home" asp-action="Index" class="site-nav__brand">TheDrinkVN</a>

            <ul class="site-nav__links">
                <li><a asp-controller="SanPham" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "SanPham" ? "active" : "")">Shop</a></li>
                <li><a href="#">Categories</a></li>
                <li><a href="#">About</a></li>
            </ul>

            <div class="site-nav__right">
                <div class="site-nav__search">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search coffees..." aria-label="Search" />
                </div>

                <a href="#" class="site-nav__icon-btn" aria-label="Cart" title="Giỏ hàng">
                    <i class="bi bi-bag" style="font-size:17px;"></i>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "U";
                    var initial = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "U";

                    <div class="nav-profile" id="nav-profile">
                        <button class="nav-profile__btn" id="nav-profile-btn" aria-expanded="false" aria-haspopup="true" title="Tài khoản của tôi">
                            <span class="nav-profile__avatar">@initial</span>
                            <i class="bi bi-chevron-down nav-profile__caret" style="font-size:12px;"></i>
                        </button>
                        <div class="nav-profile__dropdown" id="nav-profile-dropdown" role="menu">
                            <div class="nav-profile__header">
                                <span class="nav-profile__name">@displayName</span>
                                <span class="nav-profile__role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                            </div>
                            <a asp-controller="Auth" asp-action="ChangePassword" class="nav-profile__item" role="menuitem">
                                <i class="bi bi-lock" style="font-size:14px;"></i>
                                Đổi mật khẩu
                            </a>
                            <div class="nav-profile__divider"></div>
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav-profile__item nav-profile__item--danger" role="menuitem">
                                    <i class="bi bi-box-arrow-right" style="font-size:14px;"></i>
                                    Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn-nav-login">Đăng nhập</a>
                    <a asp-controller="Auth" asp-action="Register" class="btn-nav-register">Đăng ký</a>
                }
            </div>
        </div>
    </nav>
}

<!-- Main content -->
@if (isAuth)
{
    <!-- Back-to-home link overlaid on auth pages -->
    <a asp-controller="Home" asp-action="Index" class="auth-back-home" aria-label="Quay lại trang chủ">
        <i class="bi bi-arrow-left" style="font-size:16px;"></i>
        TheDrinkVN
    </a>
    <main role="main">
        @RenderBody()
    </main>
}
else
{
    <main role="main" class="page-main">
        @RenderBody()
    </main>
}

@if (!isAuth)
{
    <!-- Footer -->
    <footer class="site-footer">
        <div class="site-footer__inner">
            <div>
                <div class="footer-brand">TheDrinkVN</div>
                <p class="footer-desc">Crafting exceptional coffee<br>experiences for the modern enthusiast.</p>
                <p class="footer-copy">© 2026 TheDrinkVN Boutique. All rights reserved.</p>
            </div>

            <div class="footer-col">
                <h4>Shop</h4>
                <ul>
                    <li><a href="#">Whole Bean</a></li>
                    <li><a href="#">Ground</a></li>
                    <li><a href="#">Equipment</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Support</h4>
                <ul>
                    <li><a href="#">Shipping Info</a></li>
                    <li><a href="#">Returns</a></li>
                    <li><a href="#">Contact Us</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Legal</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    <li><a href="#">Terms of Service</a></li>
                </ul>
            </div>
        </div>
    </footer>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    // Profile dropdown toggle
    (function () {
        var btn = document.getElementById('nav-profile-btn');
        var dropdown = document.getElementById('nav-profile-dropdown');
        if (!btn || !dropdown) return;

        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var isOpen = dropdown.classList.contains('open');
            dropdown.classList.toggle('open', !isOpen);
            btn.setAttribute('aria-expanded', String(!isOpen));
        });

        // Close on outside click
        document.addEventListener('click', function () {
            dropdown.classList.remove('open');
            btn.setAttribute('aria-expanded', 'false');
        });

        // Close on Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                dropdown.classList.remove('open');
                btn.setAttribute('aria-expanded', 'false');
                btn.focus();
            }
        });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
