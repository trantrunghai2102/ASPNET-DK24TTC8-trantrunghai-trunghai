@model BanCaPheNuocGiaiKhat.Models.ProductDetailViewModel

@{
    ViewData["Title"] = Model.Product.Name;
}

@section Styles {
    <link rel="stylesheet" href="~/css/detail-product.css" asp-append-version="true" />
}

<div class="detail-page-wrapper" style="max-width: 100%; padding: 0 2rem;">
    <nav class="detail-breadcrumb" aria-label="breadcrumb">
        <a href="/">Trang chủ</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        <a href="/SanPham">Sản phẩm</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        <span class="current">@Model.Product.Name</span>
    </nav>

    <div class="detail-container">
        <!-- Left: Images -->
        <div class="detail-gallery">
            <div class="main-image-wrapper">
                @if (Model.Product.CategoryId == 4) {
                    <span class="badge">Giải Khát</span>
                } else {
                    <span class="badge">Cà phê</span>
                }
                <img src="@Model.Product.ThumbnailUrl" alt="@Model.Product.Name" class="main-image" id="mainImage" />
            </div>
            <div class="thumbnail-list">
                @{
                    var allImages = new List<string>();
                    if (!string.IsNullOrEmpty(Model.Product.ThumbnailUrl))
                    {
                        allImages.Add(Model.Product.ThumbnailUrl);
                    }
                    if (Model.Product.ProductImages != null && Model.Product.ProductImages.Any())
                    {
                        foreach (var img in Model.Product.ProductImages.OrderBy(i => i.SortOrder))
                        {
                            if (!allImages.Contains(img.Url))
                            {
                                allImages.Add(img.Url);
                            }
                        }
                    }
                }
                @for (int i = 0; i < allImages.Count; i++)
                {
                    <div class="thumb-item @(i == 0 ? "active" : "")" onclick="changeImage(this, '@allImages[i]')">
                        <img src="@allImages[i]" />
                    </div>
                }
            </div>
        </div>

        <!-- Right: Info -->
        <div class="detail-info">
            <h1 class="detail-title">@Model.Product.Name</h1>
            


            <div class="detail-price">
                @if (Model.Product.PromotionPrice.HasValue)
                {
                    <span class="old-price">@Model.Product.BasePrice.ToString("N0") vnđ</span>
                    <span class="current-price promotion">@Model.Product.PromotionPrice.Value.ToString("N0") vnđ</span>
                }
                else
                {
                    <span class="current-price">@Model.Product.BasePrice.ToString("N0") vnđ</span>
                }
            </div>

            <p class="detail-desc">@Model.Product.ShortDesc</p>


            <div class="detail-actions">
                    <form id="gioHangForm" asp-controller="GioHang" asp-action="ThemAjax" method="post" hidden>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProductId" value="@Model.Product.ProductId" />
                    </form>
                    <div class="quantity-selector">
                        <button type="button" class="qty-btn minus" onclick="updateQty(-1)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
                        <input type="number" id="detailQtyInput" name="Quantity" form="gioHangForm" class="qty-input" value="1" min="1" max="@Model.Product.StockQty" />
                        <button type="button" class="qty-btn plus" onclick="updateQty(1)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
                    </div>
                    <button type="button" id="btnAddToCart" class="add-to-cart-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                        Thêm vào giỏ hàng
                    </button>
            </div>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" style="margin-top:.75rem;">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" style="margin-top:.75rem;">@TempData["Error"]</div>
            }

            <div class="product-features">
                <div class="feature-item">
                    <div class="feature-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
                    <div class="feature-text">
                        <strong>Chính hãng</strong>
                        <span>Sản phẩm nguồn gốc xuất xứ rõ ràng</span>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg></div>
                    <div class="feature-text">
                        <strong>Giao hàng nhanh chóng</strong>
                        <span>Nhận hàng ngay trong vòng 2-4h (nội thành)</span>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
                    <div class="feature-text">
                        <strong>Đổi trả dễ dàng</strong>
                        <span>Bảo hành nếu có lỗi từ nhà sản xuất</span>
                    </div>
                </div>
            </div>

            <div class="detail-description-box">
                <h3 class="box-title">Thông tin chi tiết</h3>
                <div class="long-desc">@Html.Raw(Model.Product.DetailDesc)</div>
            </div>
        </div>
    </div>

    @if (Model.RelatedProducts.Any())
    {
        <div class="related-section">
            <div class="related-header">
                <h2>Sản phẩm liên quan</h2>
                <a href="/SanPham" class="view-all-link">Xem tất cả <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12h14m-7-7 7 7-7 7"/></svg></a>
            </div>
            <div class="related-grid">
                @foreach (var item in Model.RelatedProducts)
                {
                    <div class="product-card">
                        <div class="product-card__img">
                            @if (item.IsNew)
                            {
                                <span class="badge-new">Single Origin</span>
                            }
                            <a href="/SanPham/Detail/@item.Slug">
                                <img src="@(item.ThumbnailUrl ?? "/images/product-ethiopian.png")" alt="@item.Name" loading="lazy" />
                            </a>
                        </div>
                        <div class="product-card__body">
                            <a href="/SanPham/Detail/@item.Slug" class="no-underline">
                                <p class="product-name">@item.Name</p>
                            </a>
                            <p class="product-desc">@item.ShortDesc</p>
                            
                            <div class="product-footer">
                                <span class="product-price sm">@item.BasePrice.ToString("N0") vnđ</span>
                                <button type="button" class="btn-add-cart" aria-label="Thêm vào giỏ" onclick="addToCartGlobal(@item.ProductId)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function changeImage(element, src) {
            document.getElementById('mainImage').src = src;
            document.querySelectorAll('.thumb-item').forEach(el => el.classList.remove('active'));
            element.classList.add('active');
        }

        function updateQty(delta) {
            var input = document.getElementById('detailQtyInput');
            if (!input) return;
            var val = parseInt(input.value) || 1;
            var max = parseInt(input.max) || 999;
            var min = parseInt(input.min) || 1;
            
            var newVal = val + delta;
            if (newVal < min) newVal = min;
            if (newVal > max) newVal = max;
            
            input.value = newVal;
        }

        var btnAdd = document.getElementById('btnAddToCart');
        if (btnAdd) {
            btnAdd.addEventListener('click', function() {
                var form = document.getElementById('gioHangForm');
                var formData = new FormData(form);
                formData.set('Quantity', document.getElementById('detailQtyInput').value);

                var originalContent = btnAdd.innerHTML;
                btnAdd.innerHTML = 'Đang xử lý...';
                btnAdd.disabled = true;

                fetch(form.action, {
                    method: 'POST',
                    body: formData
                })
                .then(res => {
                    if (res.redirected) {
                        window.location.href = res.url;
                        throw new Error('Redirecting');
                    }
                    return res.json();
                })
                .then(data => {
                    btnAdd.innerHTML = originalContent;
                    btnAdd.disabled = false;
                    
                    if (data.success) {
                        var badge = document.getElementById('cartCountBadge');
                        if (badge) {
                            badge.textContent = data.count;
                            badge.style.display = 'inline-block';
                        }
                        
                        var toastContainer = document.getElementById('toastContainer');
                        if (!toastContainer) {
                            toastContainer = document.createElement('div');
                            toastContainer.id = 'toastContainer';
                            toastContainer.style.cssText = 'position:fixed; bottom:20px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:10px;';
                            document.body.appendChild(toastContainer);
                        }
                        
                        var toast = document.createElement('div');
                        toast.style.cssText = 'background:#4c3a30; color:white; padding:12px 20px; border-radius:8px; box-shadow:0 4px 15px rgba(0,0,0,0.2); opacity:0; transform:translateY(20px); transition:all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); font-size:0.95rem; font-weight:500; display:flex; align-items:center; gap:10px;';
                        toast.innerHTML = '<i class="bi bi-check-circle-fill" style="color:#d1e7dd; font-size:1.1rem;"></i> <span>' + data.message + '</span>';
                        toastContainer.appendChild(toast);
                        
                        setTimeout(() => {
                            toast.style.opacity = '1';
                            toast.style.transform = 'translateY(0)';
                        }, 10);
                        
                        setTimeout(() => {
                            toast.style.opacity = '0';
                            toast.style.transform = 'translateY(10px)';
                            setTimeout(() => toast.remove(), 300);
                        }, 3000);
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                })
                .catch(err => {
                    if (err.message === 'Redirecting') return;
                    console.error("Fetch error:", err);
                    alert("Có lỗi hệ thống xảy ra. Vui lòng tải lại trang và thử lại.");
                    btnAdd.innerHTML = originalContent;
                    btnAdd.disabled = false;
                });
            });
        }
    </script>
}
