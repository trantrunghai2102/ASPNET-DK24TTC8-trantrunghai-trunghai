@model BanCaPheNuocGiaiKhat.Models.ProductDetailViewModel

@{
    ViewData["Title"] = Model.Product.Name;
}

@section Styles {
    <link rel="stylesheet" href="~/css/detail-product.css" asp-append-version="true" />
}

<div class="detail-page-wrapper">
    <nav class="detail-breadcrumb" aria-label="breadcrumb">
        <a href="/">Home</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        <a href="/SanPham">Shop</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        <span class="current">@Model.Product.Name</span>
    </nav>

    <div class="detail-container">
        <!-- Left: Images -->
        <div class="detail-gallery">
            <div class="main-image-wrapper">
                @if (Model.Product.ProductId == 1 || Model.Product.ProductId == 29) {
                    <span class="badge">Small Batch</span>
                } else if (Model.Product.CategoryId == 1) {
                    <span class="badge">Single Origin</span>
                }
                <img src="@Model.Product.ThumbnailUrl" alt="@Model.Product.Name" class="main-image" id="mainImage" />
            </div>
            <div class="thumbnail-list">
                @{
                    var allImages = new List<string>();
                    if (!string.IsNullOrEmpty(Model.Product.ThumbnailUrl))
                    {
                        allImages.Add(Model.Product.ThumbnailUrl);
                    }
                    if (Model.Product.ProductImages != null && Model.Product.ProductImages.Any())
                    {
                        foreach (var img in Model.Product.ProductImages.OrderBy(i => i.SortOrder))
                        {
                            if (!allImages.Contains(img.Url))
                            {
                                allImages.Add(img.Url);
                            }
                        }
                    }
                }
                @for (int i = 0; i < allImages.Count; i++)
                {
                    <div class="thumb-item @(i == 0 ? "active" : "")" onclick="changeImage(this, '@allImages[i]')">
                        <img src="@allImages[i]" />
                    </div>
                }
            </div>
        </div>

        <!-- Right: Info -->
        <div class="detail-info">
            <h1 class="detail-title">@Model.Product.Name</h1>
            
            <div class="detail-rating">
                <div class="stars">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </div>
                <span class="review-count">4.8 (124 reviews)</span>
            </div>

            <div class="detail-price">
                @if (Model.Product.PromotionPrice.HasValue)
                {
                    <span class="old-price">$@Model.Product.BasePrice.ToString("N3") vnd</span>
                    <span class="current-price promotion">$@Model.Product.PromotionPrice.Value.ToString("N3") vnd</span>
                }
                else
                {
                    <span class="current-price">$@Model.Product.BasePrice.ToString("N3") vnd</span>
                }
            </div>

            <p class="detail-desc">@Model.Product.ShortDesc</p>

            <div class="tasting-notes">
                <span class="notes-label">TASTING NOTES</span>
                <div class="notes-list">
                    <span class="note-pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg> Chocolate</span>
                    <span class="note-pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 22h20L12 2z"/></svg> Nutty</span>
                    <span class="note-pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/></svg> Caramel</span>
                </div>
            </div>

            <div class="detail-actions">
                <div class="quantity-selector">
                    <button type="button" class="qty-btn minus"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
                    <input type="number" class="qty-input" value="1" min="1" max="@Model.Product.StockQty" />
                    <button type="button" class="qty-btn plus"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
                </div>
                <button type="button" class="add-to-cart-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    Add to Cart
                </button>
            </div>

            <div class="accordion-group">
                <details class="accordion-item" open>
                    <summary class="accordion-header">
                        Coffee Details
                        <svg class="icon-plus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <svg class="icon-minus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </summary>
                    <div class="accordion-content">
                        <ul class="detail-list">
                            <li><strong>Region:</strong> <span class="capitalize">@(Model.Product.Region ?? "Blend")</span></li>
                            <li><strong>Roast:</strong> <span class="capitalize">@(Model.Product.RoastLevel ?? "Medium")</span></li>
                            <li><strong>Grind:</strong> <span class="capitalize">@(Model.Product.GrindType ?? "Whole Bean")</span></li>
                        </ul>
                        <div class="long-desc mt-3">@Html.Raw(Model.Product.DetailDesc)</div>
                    </div>
                </details>
                <details class="accordion-item">
                    <summary class="accordion-header">
                        Brewing Guide
                        <svg class="icon-plus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <svg class="icon-minus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </summary>
                    <div class="accordion-content">
                        <p>For the best experience, we recommend a 1:15 coffee to water ratio. Use filtered water just off the boil (200°F/93°C). Brew time should be around 3-4 minutes depending on your method.</p>
                    </div>
                </details>
                <details class="accordion-item">
                    <summary class="accordion-header">
                        Shipping & Returns
                        <svg class="icon-plus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <svg class="icon-minus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </summary>
                    <div class="accordion-content">
                        <p>Free standard shipping on orders over 500.000 vnd. Orders are roasted and shipped within 48 hours to ensure maximum freshness. If you're not completely satisfied, return the unused portion within 30 days.</p>
                    </div>
                </details>
            </div>
        </div>
    </div>

    @if (Model.RelatedProducts.Any())
    {
        <div class="related-section">
            <div class="related-header">
                <h2>Related Products</h2>
                <a href="/SanPham" class="view-all-link">View all <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12h14m-7-7 7 7-7 7"/></svg></a>
            </div>
            <div class="related-grid">
                @foreach (var item in Model.RelatedProducts)
                {
                    <div class="product-card">
                        <div class="product-card__img">
                            @if (item.IsNew)
                            {
                                <span class="badge-new">Single Origin</span>
                            }
                            <a href="/SanPham/Detail/@item.Slug">
                                <img src="@(item.ThumbnailUrl ?? "/images/product-ethiopian.png")" alt="@item.Name" loading="lazy" />
                            </a>
                        </div>
                        <div class="product-card__body">
                            <a href="/SanPham/Detail/@item.Slug" class="no-underline">
                                <p class="product-name">@item.Name</p>
                            </a>
                            <p class="product-desc">@item.ShortDesc</p>
                            
                            <div class="product-footer">
                                <span class="product-price sm">$@item.BasePrice.ToString("N3") vnd</span>
                                <button type="button" class="btn-add-cart" aria-label="Add to cart">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function changeImage(element, src) {
            document.getElementById('mainImage').src = src;
            document.querySelectorAll('.thumb-item').forEach(el => el.classList.remove('active'));
            element.classList.add('active');
        }
    </script>
}
