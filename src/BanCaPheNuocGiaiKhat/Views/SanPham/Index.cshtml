@model BanCaPheNuocGiaiKhat.Models.ProductListViewModel
@{
    ViewData["Title"] = "Our Coffees";
}

<div class="catalog-page">
    <div class="section-wrapper" style="max-width: 100%; padding: 0 2rem;">
        
        <header class="catalog-header">
            <h1 class="catalog-title">Sản Phẩm</h1>
            <p class="catalog-subtitle">Khám phá bộ sưu tập cà phê nguyên bản và pha trộn thủ công tinh tế của chúng tôi.</p>
        </header>

        <form id="filterForm" method="get" asp-controller="SanPham" asp-action="Index">
            
            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />

            <!-- Toolbar: Search and Sort -->
            <div class="catalog-toolbar">
                <div class="toolbar-search">
                    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                    </svg>
                    <input type="text" name="search" value="@Model.SearchQuery" placeholder="Tìm kiếm sản phẩm..." class="toolbar-search-input" onkeypress="if(event.key === 'Enter') { document.getElementById('filterForm').submit(); }" />
                </div>

                <div class="toolbar-sort">
                    <select name="sortBy" class="toolbar-sort-select" onchange="document.getElementById('filterForm').submit();">
                        <option value="popularity" selected="@(Model.SortBy == "popularity" ? "selected" : null)">Sắp xếp: Phổ biến nhất</option>
                        <option value="price-asc" selected="@(Model.SortBy == "price-asc" ? "selected" : null)">Giá: Thấp đến Cao</option>
                        <option value="price-desc" selected="@(Model.SortBy == "price-desc" ? "selected" : null)">Giá: Cao xuống Thấp</option>
                    </select>
                </div>
            </div>

            <!-- Main catalog layout: Sidebar filters + Grid -->
            <div class="catalog-layout">
                
                <!-- Sidebar Filters -->
                <aside class="catalog-sidebar">
                    <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--coffee-darkest); margin-bottom: 1.2rem; letter-spacing: -0.02em;">Danh mục</h3>
                    <div style="display: flex; flex-direction: column; gap: 0.8rem;">
                        <a href="@Url.Action("Index", "SanPham", new { search = Model.SearchQuery, sortBy = Model.SortBy })" 
                           style="text-decoration: none; font-weight: @(Model.SelectedCategoryId == null ? "800" : "500"); color: @(Model.SelectedCategoryId == null ? "var(--coffee-darkest)" : "var(--text-secondary)");">Tất cả</a>
                        
                        @foreach (var parentCat in Model.Categories.Where(c => c.ParentId == null))
                        {
                            bool hasChildren = Model.Categories.Any(c => c.ParentId == parentCat.CategoryId);
                            bool isParentActive = Model.SelectedCategoryId == parentCat.CategoryId ||
                                (Model.SelectedCategoryId != null && (
                                    Model.Categories.Any(c => c.ParentId == parentCat.CategoryId && c.CategoryId == Model.SelectedCategoryId) ||
                                    Model.Categories.Any(c => c.ParentId != null && Model.Categories.Any(p => p.CategoryId == c.ParentId && p.ParentId == parentCat.CategoryId) && c.CategoryId == Model.SelectedCategoryId)
                                ));

                            <div style="display: flex; flex-direction: column;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <a href="@Url.Action("Index", "SanPham", new { categoryId = parentCat.CategoryId, search = Model.SearchQuery, sortBy = Model.SortBy })" 
                                       style="text-decoration: none; font-weight: @(Model.SelectedCategoryId == parentCat.CategoryId ? "800" : "600"); color: @(Model.SelectedCategoryId == parentCat.CategoryId ? "var(--coffee-darkest)" : "var(--text-secondary)");">
                                        @parentCat.Name
                                    </a>
                                    @if (hasChildren)
                                    {
                                        <button type="button" onclick="toggleSubcategory('sub-@parentCat.CategoryId', this)" style="background: none; border: none; padding: 0.2rem; cursor: pointer; color: var(--text-muted); display: grid; place-items: center;">
                                            <i class="bi @(isParentActive ? "bi-chevron-down" : "bi-chevron-right")" style="font-size: 0.75rem;"></i>
                                        </button>
                                    }
                                </div>
                                
                                @if (hasChildren)
                                {
                                    <div id="sub-@parentCat.CategoryId" style="display: @(isParentActive ? "flex" : "none"); flex-direction: column; gap: 0.4rem; padding-left: 1rem; border-left: 2px solid #e2cbb8; margin-left: 0.2rem; margin-top: 0.4rem;">
                                        @foreach (var childCat in Model.Categories.Where(c => c.ParentId == parentCat.CategoryId))
                                        {
                                            bool hasGrandchildren = Model.Categories.Any(c => c.ParentId == childCat.CategoryId);
                                            bool isChildActive = Model.SelectedCategoryId == childCat.CategoryId || 
                                                (Model.SelectedCategoryId != null && Model.Categories.Any(c => c.ParentId == childCat.CategoryId && c.CategoryId == Model.SelectedCategoryId));
                                                
                                            <div style="display: flex; flex-direction: column;">
                                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                                    <a href="@Url.Action("Index", "SanPham", new { categoryId = childCat.CategoryId, search = Model.SearchQuery, sortBy = Model.SortBy })" 
                                                       style="text-decoration: none; font-size: 0.95rem; font-weight: @(Model.SelectedCategoryId == childCat.CategoryId ? "800" : "500"); color: @(Model.SelectedCategoryId == childCat.CategoryId ? "var(--coffee-mid)" : "var(--text-muted)");">
                                                        @childCat.Name
                                                    </a>
                                                    @if (hasGrandchildren)
                                                    {
                                                        <button type="button" onclick="toggleSubcategory('sub-@childCat.CategoryId', this)" style="background: none; border: none; padding: 0.2rem; cursor: pointer; color: var(--text-muted); display: grid; place-items: center;">
                                                            <i class="bi @(isChildActive ? "bi-chevron-down" : "bi-chevron-right")" style="font-size: 0.65rem;"></i>
                                                        </button>
                                                    }
                                                </div>
                                                
                                                @if (hasGrandchildren)
                                                {
                                                    <div id="sub-@childCat.CategoryId" style="display: @(isChildActive ? "flex" : "none"); flex-direction: column; gap: 0.4rem; padding-left: 0.8rem; border-left: 1px dashed #d8c4b7; margin-left: 0.4rem; margin-top: 0.4rem; padding-top: 0.2rem;">
                                                        @foreach (var grandChild in Model.Categories.Where(c => c.ParentId == childCat.CategoryId))
                                                        {
                                                            <a href="@Url.Action("Index", "SanPham", new { categoryId = grandChild.CategoryId, search = Model.SearchQuery, sortBy = Model.SortBy })" 
                                                               style="text-decoration: none; font-size: 0.85rem; font-weight: @(Model.SelectedCategoryId == grandChild.CategoryId ? "800" : "500"); color: @(Model.SelectedCategoryId == grandChild.CategoryId ? "var(--coffee-mid)" : "var(--text-muted)");">
                                                                @grandChild.Name
                                                            </a>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </aside>

                <!-- Product List and Pagination -->
                <main class="catalog-main">
                    @if (Model.Products.Any())
                    {
                        <div class="catalog-grid">
                            @foreach (var product in Model.Products)
                            {
                                <div class="product-card">
                                    <div class="product-card__img">
                                        @if (product.IsNew)
                                        {
                                            <span class="badge-new">NEW</span>
                                        }
                                        else if (product.IsBestseller)
                                        {
                                            <span class="badge-bestseller">BESTSELLER</span>
                                        }
                                        <a href="/SanPham/Detail/@product.Slug">
                                            <img src="@(product.ThumbnailUrl ?? "/images/product-ethiopian.png")" alt="@product.Name" loading="lazy" />
                                        </a>
                                    </div>
                                    <div class="product-card__body">
                                        <p class="product-tag">TheDrinkVN</p>
                                        <a href="/SanPham/Detail/@product.Slug" style="text-decoration: none; color: inherit;">
                                            <p class="product-name">@product.Name</p>
                                        </a>
                                        <p class="product-desc">@product.ShortDesc</p>
                                        <!-- Removed RoastLevel meta -->
                                        <div class="product-footer">
                                            <span class="product-price sm">@product.BasePrice.ToString("N0") vnđ</span>
                                            <button type="button" class="btn-add-cart" aria-label="Thêm vào giỏ" title="Thêm vào giỏ" onclick="addToCartGlobal(@product.ProductId)">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                                                    <line x1="3" y1="6" x2="21" y2="6"/>
                                                    <path d="M16 10a4 4 0 0 1-8 0"/>
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <div class="pagination-container">
                                <ul class="pagination">
                                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                        <button type="submit" name="page" value="@(Model.CurrentPage - 1)" class="page-link" @(Model.CurrentPage == 1 ? "disabled" : "")>
                                            &laquo; Trước
                                        </button>
                                    </li>
                                    
                                    @for (int p = 1; p <= Model.TotalPages; p++)
                                    {
                                        <li class="page-item @(Model.CurrentPage == p ? "active" : "")">
                                            <button type="submit" name="page" value="@p" class="page-link @(Model.CurrentPage == p ? "active" : "")">
                                                @p
                                            </button>
                                        </li>
                                    }

                                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                        <button type="submit" name="page" value="@(Model.CurrentPage + 1)" class="page-link" @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")>
                                            Sau &raquo;
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-products">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/>
                            </svg>
                            <h3>Không tìm thấy sản phẩm nào</h3>
                            <p>Vui lòng thử lại với các bộ lọc hoặc từ khóa tìm kiếm khác.</p>
                            <a href="@Url.Action("Index", "SanPham")" class="btn-coffee mt-3">Xóa bộ lọc</a>
                        </div>
                    }
                </main>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <script>
        function toggleSubcategory(id, btn) {
            const el = document.getElementById(id);
            const icon = btn.querySelector('i');
            if (el.style.display === 'none') {
                el.style.display = 'flex';
                icon.classList.remove('bi-chevron-right');
                icon.classList.add('bi-chevron-down');
            } else {
                el.style.display = 'none';
                icon.classList.remove('bi-chevron-down');
                icon.classList.add('bi-chevron-right');
            }
        }
    </script>
}
