@model BanCaPheNuocGiaiKhat.Models.DanhSachHoaDonViewModel
@{
    ViewData["Title"] = "Quản lý hóa đơn";
}

@section Styles {
<style>
.hoadon-table-wrap {
    background: var(--cream-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}
.hoadon-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .88rem;
}
.hoadon-table thead { background: var(--cream-deep); }
.hoadon-table th {
    padding: .75rem 1rem;
    text-align: left;
    font-weight: 700;
    font-size: .78rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: .05em;
    border-bottom: 1px solid var(--border);
}
.hoadon-table td {
    padding: .75rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
    vertical-align: middle;
}
.hoadon-table tbody tr:last-child td { border-bottom: none; }
.hoadon-table tbody tr:hover { background: var(--cream-base); }
.invoice-code-badge {
    display: inline-block;
    background: var(--coffee-darkest);
    color: #fff;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .05em;
    padding: .2rem .6rem;
    border-radius: 100px;
}
.amount-cell { font-weight: 700; color: var(--coffee-darkest); }
.action-cell { display: flex; gap: .5rem; align-items: center; }
.btn-view {
    padding: .35rem .75rem;
    background: var(--cream-deep);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: .8rem;
    font-weight: 600;
    text-decoration: none;
    transition: background .15s;
}
.btn-view:hover { background: var(--border); }
.btn-delete {
    padding: .35rem .75rem;
    background: #ffeaea;
    color: #c0392b;
    border: 1px solid #f5c6c6;
    border-radius: var(--radius-md);
    font-size: .8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .15s;
}
.btn-delete:hover { background: #f5c6c6; }
.empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--text-muted);
}
.alert-success {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
    padding: .75rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
    font-size: .88rem;
}
</style>
}

<div class="catalog-page" style="max-width: 100%; padding: 0 1.5rem;">
    <div style="width: 100%;">
        <header class="catalog-header" style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:1rem;">
            <div>
                <h1 class="catalog-title">Quản lý hóa đơn</h1>
                <p class="catalog-subtitle">Danh sách tất cả hóa đơn đã thanh toán.</p>
            </div>
            <form method="get" style="display:flex; gap: .5rem; align-items:center; margin-bottom: 1.5rem;">
                <select name="type" onchange="this.form.submit()" style="padding: .5rem .8rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--cream-white); font-size: .85rem; font-weight: 600; color: var(--text-primary); outline: none; cursor: pointer;">
                    <option value="">Tất cả loại đơn</option>
                    @if (Model.FilterType == "instore") { <option value="instore" selected>Tại quầy (POS)</option> } else { <option value="instore">Tại quầy (POS)</option> }
                    @if (Model.FilterType == "online") { <option value="online" selected>Trực tuyến (Online)</option> } else { <option value="online">Trực tuyến (Online)</option> }
                </select>
            </form>
        </header>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success">@TempData["Success"]</div>
        }

        @if (!Model.Invoices.Any())
        {
            <div class="hoadon-table-wrap">
                <div class="empty-state">
                    <p>Chưa có hóa đơn nào.</p>
                    <a asp-controller="BanHang" asp-action="Index"
                       style="display:inline-block;margin-top:.75rem;font-size:.85rem;font-weight:600;color:var(--coffee-mid);">
                        Bắt đầu bán hàng →
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="hoadon-table-wrap">
                <table class="hoadon-table">
                    <thead>
                        <tr>
                            <th>Mã đơn/HD</th>
                            <th>Khách hàng</th>
                            <th>Loại đơn</th>
                            <th>Trạng thái</th>
                            <th>Thời gian</th>
                            <th>Tổng tiền</th>
                            <th>Nhân viên</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hd in Model.Invoices)
                        {
                            <tr>
                                <td><span class="invoice-code-badge">@hd.InvoiceCode</span></td>
                                <td style="font-weight:600;color:var(--text-primary);">@(string.IsNullOrEmpty(hd.CustomerName) ? "Vãng lai" : hd.CustomerName)</td>
                                <td>
                                    @if (hd.OrderType?.ToLower() == "online") { <span style="color:#007bff;font-weight:600">Online</span> } else { <span style="color:#28a745;font-weight:600">POS</span> }
                                </td>
                                <td>
                                    @switch (hd.Status) {
                                        case "pending": <span style="color:#ffc107;font-weight:600">Chờ xử lý</span>; break;
                                        case "processing": <span style="color:#17a2b8;font-weight:600">Đang xử lý</span>; break;
                                        case "shipping": <span style="color:#007bff;font-weight:600">Đang giao</span>; break;
                                        case "delivered": <span style="color:#28a745;font-weight:600">Đã giao</span>; break;
                                        case "paid": <span style="color:#28a745;font-weight:600">Hoàn tất</span>; break;
                                        case "completed": <span style="color:#28a745;font-weight:600">Hoàn tất</span>; break;
                                        case "cancelled": <span style="color:#dc3545;font-weight:600">Đã hủy</span>; break;
                                        default: <span style="font-weight:600;color:var(--text-secondary)">@hd.Status</span>; break;
                                    }
                                </td>
                                <td>@hd.Date.ToLocalTime().ToString("HH:mm — dd/MM/yyyy")</td>
                                <td class="amount-cell">@hd.TotalAmount.ToString("N0") vnđ</td>
                                <td>@(hd.StaffName ?? "—")</td>
                                <td>
                                    <div class="action-cell">
                                        @if (hd.OrderType?.ToLower() == "online")
                                        {
                                            <a asp-controller="DonHangOnline" asp-action="ChiTiet"
                                               asp-route-id="@hd.OrderId" class="btn-view">Xem</a>
                                        }
                                        else if (hd.InvoiceId > 0)
                                        {
                                            <a asp-controller="StaffHoaDon" asp-action="ChiTiet"
                                               asp-route-id="@hd.InvoiceId" class="btn-view">Xem</a>
                                        }
                                        
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div style="display:flex;justify-content:center;gap:.4rem;margin-top:1.5rem;flex-wrap:wrap;">
                @if (Model.CurrentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-type="@Model.FilterType"
                       style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--cream-white);color:var(--text-primary);text-decoration:none;font-size:.85rem;">‹</a>
                }
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="Index" asp-route-page="@p" asp-route-type="@Model.FilterType"
                       style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid @(p == Model.CurrentPage ? "var(--coffee-dark)" : "var(--border)");border-radius:var(--radius-md);background:@(p == Model.CurrentPage ? "var(--coffee-dark)" : "var(--cream-white)");color:@(p == Model.CurrentPage ? "#fff" : "var(--text-primary)");text-decoration:none;font-size:.85rem;font-weight:@(p == Model.CurrentPage ? "700" : "400");">@p</a>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-type="@Model.FilterType"
                       style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--cream-white);color:var(--text-primary);text-decoration:none;font-size:.85rem;">›</a>
                }
            </div>
        }
    </div>
</div>