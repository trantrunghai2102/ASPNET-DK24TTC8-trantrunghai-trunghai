@model BanCaPheNuocGiaiKhat.Models.ThanhToanViewModel
@{
    ViewData["Title"] = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
.thanhtoan-layout {
    max-width: 700px;
    margin: 0 auto;
}
.thanhtoan-card {
    background: var(--cream-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    margin-bottom: 1.5rem;
}
.thanhtoan-card h2 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--coffee-darkest);
    margin-bottom: 1rem;
    padding-bottom: .75rem;
    border-bottom: 1px solid var(--border);
}
.order-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .88rem;
}
.order-table th {
    text-align: left;
    padding: .5rem .75rem;
    font-weight: 600;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
    background: var(--cream-deep);
}
.order-table td {
    padding: .6rem .75rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
    vertical-align: middle;
}
.order-table td.text-right,
.order-table th.text-right { text-align: right; }
.order-table .total-row td {
    font-weight: 700;
    font-size: .95rem;
    color: var(--coffee-darkest);
    border-top: 2px solid var(--border);
    border-bottom: none;
}
.payment-form-group {
    margin-bottom: 1.25rem;
}
.payment-form-group label {
    display: block;
    font-size: .88rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: .4rem;
}
.payment-input {
    width: 100%;
    padding: .7rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 1rem;
    background: var(--cream-base);
    color: var(--text-primary);
    outline: none;
    transition: border-color .2s;
}
.payment-input:focus { border-color: var(--coffee-mid); }
.change-display {
    background: var(--cream-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
}
.change-display .label {
    font-size: .9rem;
    color: var(--text-secondary);
}
.change-display .amount {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--coffee-mid);
}
.change-display .amount.negative { color: #c0392b; }
.action-row {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
}
.btn-back {
    flex: 1;
    padding: .75rem;
    background: var(--cream-deep);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: .9rem;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    transition: background .2s;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
}
.btn-back:hover { background: var(--border); }
.btn-pay {
    flex: 2;
    padding: .75rem;
    background: var(--coffee-dark);
    color: #fff;
    border: none;
    border-radius: var(--radius-md);
    font-size: .95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .2s;
}
.btn-pay:hover { background: var(--coffee-darkest); }
.btn-pay:disabled { background: #ccc; cursor: not-allowed; }
.alert-tt {
    padding: .65rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
    font-size: .85rem;
    background: #ffeaea;
    color: #c0392b;
    border: 1px solid #f5c6c6;
}
</style>
}

<div class="catalog-page">
    <div class="section-wrapper">
        <header class="catalog-header">
            <h1 class="catalog-title">Thanh toán</h1>
            <p class="catalog-subtitle">Nhập số tiền khách đưa và xác nhận thanh toán.</p>
        </header>

        @if (TempData["Error"] != null)
        {
            <div class="alert-tt">@TempData["Error"]</div>
        }

        <div class="thanhtoan-layout">

            <div class="thanhtoan-card">
                <h2>Chi tiết đơn hàng #@Model.OrderId</h2>
                <table class="order-table">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-right">Đơn giá</th>
                            <th class="text-right">SL</th>
                            <th class="text-right">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-right">@item.UnitPrice.ToString("N3") vnđ</td>
                                <td class="text-right">@item.Quantity</td>
                                <td class="text-right">@item.Subtotal.ToString("N3") vnđ</td>
                            </tr>
                        }
                        <tr class="total-row">
                            <td colspan="3">Tổng tiền</td>
                            <td class="text-right">@Model.TotalAmount.ToString("N3") vnđ</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="thanhtoan-card">
                <h2>Nhập tiền khách đưa</h2>

                <form method="post" asp-action="XacNhanThanhToan" asp-controller="BanHang" id="payForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@Model.OrderId" />

                    <div class="payment-form-group">
                        <label for="cashGiven">Tiền khách đưa (USD)</label>
                        <input type="number"
                               id="cashGiven"
                               name="cashGiven"
                               class="payment-input"
                               min="0"
                               step="0.01"
                               placeholder="0.00"
                               autocomplete="off"
                               oninput="calcChange()" />
                    </div>

                    <div class="change-display">
                        <span class="label">Tiền thừa trả khách</span>
                        <span class="amount" id="changeDisplay">—</span>
                    </div>

                    <div class="action-row">
                        <a href="/BanHang" class="btn-back"><i class="bi bi-arrow-left"></i> Quay lại</a>
                        <button type="submit" class="btn-pay" id="btnPay" disabled>
                            Xác nhận thanh toán
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
var totalAmount = @Model.TotalAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

function calcChange() {
    var cashInput = document.getElementById('cashGiven');
    var changeEl  = document.getElementById('changeDisplay');
    var btnPay    = document.getElementById('btnPay');
    var cash      = parseFloat(cashInput.value) || 0;
    var change    = cash - totalAmount;

    if (cash <= 0) {
        changeEl.textContent = '—';
        changeEl.className   = 'amount';
        btnPay.disabled      = true;
        return;
    }

    if (change < 0) {
        changeEl.textContent = '−$' + Math.abs(change).toFixed(2) + ' (thiếu)';
        changeEl.className   = 'amount negative';
        btnPay.disabled      = true;
    } else {
        changeEl.textContent = change.toFixed(3) + ' vnđ';
        changeEl.className   = 'amount';
        btnPay.disabled      = false;
    }
}
</script>
}