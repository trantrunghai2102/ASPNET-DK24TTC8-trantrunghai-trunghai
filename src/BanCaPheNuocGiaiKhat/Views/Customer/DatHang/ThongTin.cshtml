@model BanCaPheNuocGiaiKhat.Models.DatHangViewModel

@{
    ViewData["Title"] = "Thông tin đặt hàng";
}

<div class="catalog-page">
    <div class="section-wrapper">
        <header class="catalog-header">
            <h1 class="catalog-title">Thông tin đặt hàng</h1>
            <p class="catalog-subtitle">Nhập thông tin nhận hàng và xác nhận đơn hàng của bạn.</p>
        </header>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div style="display:grid;grid-template-columns:1fr 380px;gap:2rem;align-items:start;">

            <!-- Form nhập thông tin -->
            <form asp-action="XacNhan" method="post">
                @Html.AntiForgeryToken()
                <div style="background:var(--cream-white);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.5rem;box-shadow:var(--shadow-sm);">
                    <h2 style="font-size:1.1rem;font-weight:700;color:var(--text-primary);margin:0 0 1.25rem;">Thông tin người nhận</h2>

                    <div style="display:grid;gap:1rem;">
                        <div>
                            <label asp-for="RecipientName" style="font-size:.85rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:.4rem;"></label>
                            <input asp-for="RecipientName" class="form-control"
                                   style="width:100%;padding:.6rem .875rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--cream-base);" />
                            <span asp-validation-for="RecipientName" style="font-size:.8rem;color:#dc2626;"></span>
                        </div>

                        <div>
                            <label asp-for="RecipientPhone" style="font-size:.85rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:.4rem;"></label>
                            <input asp-for="RecipientPhone" class="form-control"
                                   style="width:100%;padding:.6rem .875rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--cream-base);" />
                            <span asp-validation-for="RecipientPhone" style="font-size:.8rem;color:#dc2626;"></span>
                        </div>

                        <div>
                            <label asp-for="DeliveryAddress" style="font-size:.85rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:.4rem;"></label>
                            <textarea asp-for="DeliveryAddress" rows="3"
                                      style="width:100%;padding:.6rem .875rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--cream-base);resize:vertical;"></textarea>
                            <span asp-validation-for="DeliveryAddress" style="font-size:.8rem;color:#dc2626;"></span>
                        </div>

                        <div>
                            <label asp-for="Notes" style="font-size:.85rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:.4rem;"></label>
                            <textarea asp-for="Notes" rows="2" placeholder="Ghi chú cho người giao hàng (tuỳ chọn)..."
                                      style="width:100%;padding:.6rem .875rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--cream-base);resize:vertical;"></textarea>
                        </div>
                    </div>

                    <div style="display:flex;gap:.75rem;margin-top:1.5rem;">
                        <a asp-controller="GioHang" asp-action="Index" class="btn btn-coffee" style="background:var(--cream-deep);color:var(--text-primary);border:1px solid var(--border);">
                            <i class="bi bi-arrow-left"></i> Quay lại giỏ hàng
                        </a>
                        <button type="submit" class="btn btn-coffee">
                            <i class="bi bi-check-circle"></i> Xác nhận đặt hàng
                        </button>
                    </div>
                </div>
            </form>

            <!-- Tóm tắt đơn hàng -->
            <div style="background:var(--cream-white);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.25rem;box-shadow:var(--shadow-sm);">
                <h2 style="font-size:1rem;font-weight:700;color:var(--text-primary);margin:0 0 1rem;">Tóm tắt đơn hàng</h2>
                <div style="display:grid;gap:.75rem;">
                    @foreach (var item in Model.Items)
                    {
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:.5rem;">
                            <span style="font-size:.85rem;color:var(--text-secondary);flex:1;">@item.ProductName <span style="color:var(--text-muted);">x@(item.Quantity)</span></span>
                            <span style="font-size:.85rem;font-weight:600;color:var(--text-primary);white-space:nowrap;">@item.Subtotal.ToString("N3") vnđ</span>
                        </div>
                    }
                </div>
                <hr style="border:none;border-top:1px solid var(--border);margin:1rem 0;" />
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-weight:700;color:var(--text-primary);">Tổng cộng</span>
                    <span style="font-size:1.15rem;font-weight:700;color:var(--coffee-darkest);">@Model.TotalAmount.ToString("N3") vnđ</span>
                </div>
                <p style="font-size:.78rem;color:var(--text-muted);margin-top:.75rem;">
                    <i class="bi bi-info-circle"></i> Thanh toán khi nhận hàng (COD).
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}