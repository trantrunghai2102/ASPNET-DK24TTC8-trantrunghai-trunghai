@model BanCaPheNuocGiaiKhat.Models.DonHangCuaToiChiTietViewModel

@{
    ViewData["Title"] = $"Theo dõi đơn #{Model.OrderId}";

    var steps = new[] { "pending", "processing", "shipping", "delivered" };
    var stepLabels = new[] { "Chờ xác nhận", "Đang xử lý", "Đang vận chuyển", "Đã giao hàng" };
    var stepIcons = new[] { "bi-hourglass-split", "bi-box-seam", "bi-truck", "bi-check-circle-fill" };

    bool isCancelled = Model.Status == "cancelled";
    int currentStep = isCancelled ? -1 : Array.IndexOf(steps, Model.Status);

    string PayLabel(string s) => s == "paid" ? "Đã thanh toán" : "Chưa thanh toán";
    string PayStyle(string s) => s == "paid"
        ? "background:#dcfce7;color:#15803d;"
        : "background:#fef9c3;color:#a16207;";
}

<div class="catalog-page">
    <div class="section-wrapper">

        <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1.5rem;">
            <a asp-action="DonHangCuaToi" style="color:var(--text-muted);text-decoration:none;font-size:.875rem;">
                <i class="bi bi-arrow-left"></i> Đơn hàng của tôi
            </a>
            <span style="color:var(--border);">/</span>
            <span style="font-size:.875rem;color:var(--text-secondary);">Đơn #@Model.OrderId</span>
        </div>

        <div style="display:grid;gap:1.25rem;max-width:680px;margin:0 auto;">

            <div style="background:var(--cream-white);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.5rem;box-shadow:var(--shadow-sm);">
                @if (isCancelled)
                {
                    <div style="display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem;background:#fee2e2;border-radius:var(--radius-sm);">
                        <i class="bi bi-x-circle-fill" style="font-size:1.5rem;color:#b91c1c;"></i>
                        <div>
                            <div style="font-weight:700;color:#b91c1c;">Đơn hàng đã bị hủy</div>
                            <div style="font-size:.8rem;color:#991b1b;">Cập nhật lúc @Model.UpdatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</div>
                        </div>
                    </div>
                }
                else
                {
                    <div style="display:flex;justify-content:space-between;position:relative;padding:0 .5rem;">
                        <div style="position:absolute;top:1.25rem;left:12%;right:12%;height:2px;background:var(--border);z-index:0;"></div>
                        @for (int i = 0; i < steps.Length; i++)
                        {
                            bool done    = i <= currentStep;
                            bool current = i == currentStep;
                            <div style="display:flex;flex-direction:column;align-items:center;flex:1;position:relative;z-index:1;">
                                <div style="width:2.5rem;height:2.5rem;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.1rem;@(done ? "background:var(--coffee-darkest);color:#fff;" : "background:var(--cream-deep);color:var(--text-muted);border:1px solid var(--border);")">
                                    <i class="bi @stepIcons[i]"></i>
                                </div>
                                <div style="font-size:.72rem;font-weight:@(current ? "700" : "500");color:@(done ? "var(--coffee-darkest)" : "var(--text-muted)");text-align:center;margin-top:.4rem;line-height:1.3;max-width:70px;">
                                    @stepLabels[i]
                                </div>
                            </div>
                        }
                    </div>
                    <p style="font-size:.8rem;color:var(--text-muted);text-align:center;margin:.75rem 0 0;">
                        Cập nhật lần cuối: @Model.UpdatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")
                    </p>
                }
            </div>

            <div style="background:var(--cream-white);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.25rem;box-shadow:var(--shadow-sm);">
                <h2 style="font-size:.95rem;font-weight:700;color:var(--text-primary);margin:0 0 .875rem;">
                    <i class="bi bi-geo-alt"></i> Thông tin giao hàng
                </h2>
                <div style="display:grid;gap:.5rem;font-size:.875rem;">
                    <div style="display:flex;gap:.5rem;">
                        <span style="color:var(--text-muted);min-width:120px;">Người nhận:</span>
                        <span style="font-weight:600;color:var(--text-primary);">@Model.RecipientName</span>
                    </div>
                    <div style="display:flex;gap:.5rem;">
                        <span style="color:var(--text-muted);min-width:120px;">Điện thoại:</span>
                        <span style="color:var(--text-primary);">@Model.RecipientPhone</span>
                    </div>
                    <div style="display:flex;gap:.5rem;">
                        <span style="color:var(--text-muted);min-width:120px;">Địa chỉ:</span>
                        <span style="color:var(--text-primary);">@Model.DeliveryAddress</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div style="display:flex;gap:.5rem;">
                            <span style="color:var(--text-muted);min-width:120px;">Ghi chú:</span>
                            <span style="color:var(--text-secondary);font-style:italic;">@Model.Notes</span>
                        </div>
                    }
                    <div style="display:flex;gap:.5rem;">
                        <span style="color:var(--text-muted);min-width:120px;">Ngày đặt:</span>
                        <span style="color:var(--text-primary);">@Model.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</span>
                    </div>
                    <div style="display:flex;gap:.5rem;align-items:center;">
                        <span style="color:var(--text-muted);min-width:120px;">Thanh toán:</span>
                        <span style="font-size:.8rem;font-weight:600;padding:.2rem .6rem;border-radius:20px;@PayStyle(Model.PaymentStatus)">
                            @PayLabel(Model.PaymentStatus)
                        </span>
                    </div>
                </div>
            </div>

            <div style="background:var(--cream-white);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.25rem;box-shadow:var(--shadow-sm);">
                <h2 style="font-size:.95rem;font-weight:700;color:var(--text-primary);margin:0 0 .875rem;">
                    <i class="bi bi-bag"></i> Sản phẩm (@Model.Items.Count)
                </h2>
                <div style="display:grid;gap:.6rem;">
                    @foreach (var item in Model.Items)
                    {
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:.5rem;font-size:.875rem;">
                            <div style="flex:1;">
                                <span style="color:var(--text-secondary);">@item.ProductName</span>
                                <span style="color:var(--text-muted);"> x@(item.Quantity)</span>
                            </div>
                            <span style="font-weight:600;color:var(--text-primary);white-space:nowrap;">
                                @item.Subtotal.ToString("N3") vnđ
                            </span>
                        </div>
                    }
                </div>
                <hr style="border:none;border-top:1px solid var(--border);margin:.875rem 0;" />
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-weight:700;color:var(--text-primary);">Tổng cộng</span>
                    <span style="font-size:1.1rem;font-weight:700;color:var(--coffee-darkest);">@Model.TotalAmount.ToString("N3") vnđ</span>
                </div>
                <p style="font-size:.78rem;color:var(--text-muted);margin-top:.4rem;">
                    <i class="bi bi-cash-coin"></i> Thanh toán tiền mặt khi nhận hàng.
                </p>
            </div>

            <div style="text-align:center;">
                <a asp-action="DonHangCuaToi" style="display:inline-flex;align-items:center;gap:.4rem;padding:.5rem 1.25rem;border-radius:var(--radius-sm);background:var(--cream-deep);color:var(--text-primary);font-size:.875rem;font-weight:600;text-decoration:none;border:1px solid var(--border);">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>

        </div>
    </div>
</div>