@model BanCaPheNuocGiaiKhat.Models.AdminProductCreateViewModel
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<header class="admin-topbar">
    <div>
        <p class="admin-kicker">INVENTORY</p>
        <h1>New Product</h1>
    </div>
</header>

<section class="admin-panel" style="max-width: 900px;">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="admin-panel__header">
            <small style="font-weight: 800; color: #4e3a2f; letter-spacing: .05em;">PRODUCT DETAILS</small>
        </div>
        <div class="admin-form-grid">
            <div class="admin-field">
                <label asp-for="Name">Product Name *</label>
                <input asp-for="Name" required placeholder="e.g. Ethiopian Yirgacheffe" />
                <span asp-validation-for="Name" class="text-danger" style="font-size:.75rem;"></span>
            </div>
            
            <div class="admin-field">
                <label asp-for="Slug">URL Slug *</label>
                <input asp-for="Slug" required placeholder="e.g. ethiopian-yirgacheffe" />
                <span asp-validation-for="Slug" class="text-danger" style="font-size:.75rem;"></span>
            </div>

            <div class="admin-field">
                <label asp-for="CategoryId">Category *</label>
                <select asp-for="CategoryId" required>
                    <option value="">-- Select Category --</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in ViewBag.Categories)
                        {
                            <option value="@cat.CategoryId">@cat.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger" style="font-size:.75rem;"></span>
            </div>

            <div class="admin-field">
                <label asp-for="StockQty">Initial Stock *</label>
                <input asp-for="StockQty" type="number" min="0" required placeholder="0" />
                <span asp-validation-for="StockQty" class="text-danger" style="font-size:.75rem;"></span>
            </div>

            <div class="admin-field">
                <label asp-for="BasePrice">Base Price (VND) *</label>
                <input asp-for="BasePrice" type="number" min="0" step="1000" required placeholder="0" />
                <span asp-validation-for="BasePrice" class="text-danger" style="font-size:.75rem;"></span>
            </div>

            <div class="admin-field">
                <label asp-for="PromotionPrice">Promotion Price (VND)</label>
                <input asp-for="PromotionPrice" type="number" min="0" step="1000" placeholder="Optional" />
                <span asp-validation-for="PromotionPrice" class="text-danger" style="font-size:.75rem;"></span>
            </div>

            <div class="admin-field admin-field--wide">
                <label asp-for="ShortDesc">Short Description</label>
                <input asp-for="ShortDesc" placeholder="Brief summary for catalog view" />
            </div>

            <div class="admin-field admin-field--wide">
                <label asp-for="DetailDesc">Full Description</label>
                <textarea asp-for="DetailDesc" rows="5" placeholder="Detailed product description..."></textarea>
            </div>
            
            <div class="admin-field">
                <label asp-for="RoastLevel">Roast Level</label>
                <select asp-for="RoastLevel">
                    <option value="">-- Select --</option>
                    <option value="Light">Light</option>
                    <option value="Medium">Medium</option>
                    <option value="Dark">Dark</option>
                </select>
            </div>

            <div class="admin-field">
                <label asp-for="GrindType">Grind Type</label>
                <select asp-for="GrindType">
                    <option value="">-- Select --</option>
                    <option value="Whole Bean">Whole Bean</option>
                    <option value="Espresso">Espresso</option>
                    <option value="Filter">Filter</option>
                </select>
            </div>
            
            <div class="admin-field admin-field--wide">
                <label asp-for="Region">Region / Origin</label>
                <input asp-for="Region" placeholder="e.g. Sumatra, Indonesia" />
            </div>
        </div>

        <div class="admin-panel__header" style="border-top: 1px solid #eadbd2;">
            <small style="font-weight: 800; color: #4e3a2f; letter-spacing: .05em;">PRODUCT IMAGES</small>
        </div>
        <div style="padding: 1.2rem;">
            <div class="admin-field">
                <label>Upload Images (Multiple allowed)</label>
                <input type="file" name="images" multiple accept="image/*" style="padding: 1rem; border: 2px dashed #d8c4b7; background: #fbf6f1; cursor: pointer;" />
                <p style="margin-top:.5rem; font-size:.75rem; color:#6d5a4d;">The first image will be used as the thumbnail.</p>
            </div>
        </div>

        <div class="admin-panel__header" style="border-top: 1px solid #eadbd2;">
            <small style="font-weight: 800; color: #4e3a2f; letter-spacing: .05em;">STATUS</small>
        </div>
        <div style="padding: 1.2rem;">
            <div class="admin-field">
                <label asp-for="Status">Product Status</label>
                <select asp-for="Status">
                    <option value="active">Active (Visible)</option>
                    <option value="hidden">Hidden (Draft)</option>
                </select>
            </div>
        </div>

        <div style="padding: 1.2rem; background: #fbf6f1; border-top: 1px solid #eadbd2; display: flex; justify-content: flex-end; gap: 1rem;">
            <a asp-action="AdminIndex" class="admin-secondary-btn">Cancel</a>
            <button type="submit" class="admin-primary-btn">SAVE PRODUCT</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-generate slug from name
        document.getElementById('Name').addEventListener('input', function() {
            var name = this.value;
            var slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
            document.getElementById('Slug').value = slug;
        });
    </script>
}
