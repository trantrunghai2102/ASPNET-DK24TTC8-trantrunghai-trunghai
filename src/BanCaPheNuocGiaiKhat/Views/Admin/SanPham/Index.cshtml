@model BanCaPheNuocGiaiKhat.Models.AdminProductListIndexViewModel
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<header class="admin-topbar">
    <div>
        <p class="admin-kicker">KHO HÀNG</p>
        <h1>Danh sách sản phẩm</h1>
    </div>
    <div>
        <a asp-action="Create" class="admin-new-product">
            <i class="bi bi-plus-lg"></i> THÊM SẢN PHẨM
        </a>
    </div>
</header>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="font-size: .88rem; font-weight: 600; padding: .75rem 1rem;">@TempData["Success"]</div>
}

<section class="admin-panel">
    <div class="admin-panel__header">
        <small style="font-weight: 800; color: #4e3a2f; letter-spacing: .05em;">TẤT CẢ SẢN PHẨM</small>
        <form method="get" style="display:flex; align-items:center; gap: .5rem;">
            <input type="text" name="search" value="@Model.SearchQuery" placeholder="Tìm kiếm sản phẩm..." style="padding:.4rem .8rem; border:1px solid #d8c4b7; border-radius:4px; font-size:.8rem; outline:none; min-width:250px;">
            <button type="submit" class="admin-secondary-btn" style="padding: 0.45rem 1rem; font-size: 0.8rem; border-radius: 4px; border: 1px solid #d8c4b7; background: #fff; cursor: pointer; color: #4e3a2f; font-weight: 600;">Tìm kiếm</button>
            @if (!string.IsNullOrEmpty(Model.SearchQuery))
            {
                <a asp-action="Index" style="font-size: .8rem; color: #888; text-decoration: none; margin-left: .5rem;">Xóa lọc</a>
            }
        </form>
    </div>
    
    <div class="admin-product-table">
        <div class="admin-product-table__head" style="grid-template-columns: 80px minmax(200px, 1fr) 150px 100px 100px 120px;">
            <span>Hình ảnh</span>
            <span>Sản phẩm</span>
            <span>Danh mục</span>
            <span>Giá</span>
            <span>Trạng thái</span>
            <span style="text-align: right;">Thao tác</span>
        </div>
        
        @if (!Model.Products.Any())
        {
            <div style="padding: 3rem; text-align: center; color: #6d5a4d; font-size: .85rem;">
                Không tìm thấy sản phẩm nào. <a asp-action="Create" style="color:#5b351f; font-weight:700;">Thêm mới?</a>
            </div>
        }
        else
        {
            foreach (var p in Model.Products)
            {
                <div class="admin-product-table__row" style="grid-template-columns: 80px minmax(200px, 1fr) 150px 100px 100px 120px; align-items:center;">
                    <div>
                        @if (!string.IsNullOrEmpty(p.ThumbnailUrl))
                        {
                            <img src="@p.ThumbnailUrl" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #eadbd2;" />
                        }
                        else
                        {
                            <div style="width: 50px; height: 50px; border-radius: 6px; background: #eee2dc; display:grid; place-items:center; color:#6d5a4d;">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                    </div>
                    <div>
                        <strong style="display:block; font-size:.9rem; color:#231a15;">@p.Name</strong>
                        <small style="color:#6d5a4d; font-size:.75rem;">Tồn kho: @p.StockQty</small>
                    </div>
                    <div style="font-size:.85rem; color:#6d5a4d;">@p.CategoryName</div>
                    <div style="font-size:.85rem; font-weight:700; color:#231a15;">@p.BasePrice.ToString("N0") vnd</div>
                    <div>
                        @if (p.Status == "active")
                        {
                            <span class="admin-status admin-status--green">Hoạt động</span>
                        }
                        else
                        {
                            <span class="admin-status admin-status--orange">Đã ẩn</span>
                        }
                    </div>
                    <div style="text-align: right; display:flex; gap:.3rem; justify-content:flex-end;">
                        <a asp-action="Detail" asp-route-id="@p.ProductId" class="btn btn-sm btn-light" style="font-size:.75rem;" title="Xem"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-light" style="font-size:.75rem;" title="Sửa"><i class="bi bi-pencil"></i></a>
                        <button type="button" class="btn btn-sm btn-light text-danger delete-btn" data-id="@p.ProductId" data-name="@p.Name" style="font-size:.75rem;" title="Xóa mềm"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            }
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div style="padding: 1rem 1.5rem; display:flex; gap:.5rem; justify-content:center; border-top: 1px solid #eee6de;">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.CurrentPage)
                {
                    <span style="display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; background:#4e3a2f; color:#fff; border-radius:4px; font-size:.85rem; font-weight:700;">@i</span>
                }
                else
                {
                    <a asp-action="Index" asp-route-page="@i" asp-route-search="@Model.SearchQuery" style="display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; background:#f4f0ec; color:#4e3a2f; text-decoration:none; border-radius:4px; font-size:.85rem; font-weight:600;">@i</a>
                }
            }
        </div>
    }
</section>

<!-- Floating Trash Button -->
<a href="/AdminSanPham/Trash" class="admin-trash-fab" style="position: fixed; bottom: 30px; right: 30px; width: 56px; height: 56px; background: #b02a37; color: #fff; border-radius: 50%; display: grid; place-items: center; font-size: 1.5rem; box-shadow: 0 4px 15px rgba(176, 42, 55, 0.4); text-decoration: none; z-index: 900; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='scale(1.1)'; this.style.boxShadow='0 6px 20px rgba(176, 42, 55, 0.5)';" onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='0 4px 15px rgba(176, 42, 55, 0.4)';">
    <i class="bi bi-trash3-fill"></i>
</a>

<!-- Custom Coffee Delete Modal -->
<div id="deleteModal" class="custom-modal-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(35,26,21,0.6); z-index:9999; backdrop-filter: blur(4px); justify-content:center; align-items:center;">
    <div class="custom-modal-card" style="background:#fff; border-radius:12px; border:1px solid #eadbd2; width:90%; max-width:400px; padding:1.5rem; box-shadow:0 10px 25px rgba(0,0,0,0.15); transform: translateY(-20px); transition: transform 0.2s ease;">
        <h3 style="font-size:1.1rem; color:#231a15; margin-bottom:0.75rem; font-weight:700;">Xác nhận xóa</h3>
        <p style="font-size:0.88rem; color:#6d5a4d; margin-bottom:1.5rem; line-height:1.4;">Bạn có chắc chắn muốn xóa (xóa mềm) sản phẩm <strong id="deleteProductName" style="color:#231a15;"></strong> không? Bạn vẫn có thể khôi phục lại sau.</p>
        <div style="display:flex; justify-content:flex-end; gap:0.75rem;">
            <button type="button" onclick="closeDeleteModal()" class="admin-secondary-btn" style="padding:0.4rem 1rem; font-size:0.8rem; border-radius:6px; cursor:pointer;">Hủy bỏ</button>
            <form id="deleteForm" method="post" action="">
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-primary-btn" style="background:#b02a37; border-color:#b02a37; padding:0.4rem 1rem; font-size:0.8rem; border-radius:6px; cursor:pointer; color:#fff;">Xác nhận xóa</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteModal(productId, productName) {
            const modal = document.getElementById('deleteModal');
            const nameEl = document.getElementById('deleteProductName');
            const form = document.getElementById('deleteForm');
            
            nameEl.textContent = productName;
            form.action = `/AdminSanPham/Delete/${productId}`;
            
            modal.style.display = 'flex';
            setTimeout(() => {
                modal.querySelector('.custom-modal-card').style.transform = 'translateY(0)';
            }, 10);
        }
        
        function closeDeleteModal() {
            const modal = document.getElementById('deleteModal');
            modal.querySelector('.custom-modal-card').style.transform = 'translateY(-20px)';
            setTimeout(() => {
                modal.style.display = 'none';
            }, 200);
        }

        // Bind buttons
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const name = this.getAttribute('data-name');
                openDeleteModal(id, name);
            });
        });

        // Close modal on background click
        window.onclick = function(event) {
            const modal = document.getElementById('deleteModal');
            if (event.target == modal) {
                closeDeleteModal();
            }
        }
    </script>
}

