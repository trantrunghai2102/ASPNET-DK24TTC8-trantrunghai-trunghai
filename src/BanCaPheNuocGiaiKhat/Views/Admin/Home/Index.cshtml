@model BanCaPheNuocGiaiKhat.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var maxRevenue = Model.RevenueByDay.Count == 0 ? 0 : Model.RevenueByDay.Max(x => x.Revenue);
}

<header class="admin-topbar" style="margin-bottom: 2rem;">
    <div>
        <h1>Phân Tích Doanh Thu</h1>
        <span>Theo dõi hiệu suất cửa hàng và xu hướng mua hàng.</span>
    </div>
    <div>
        <form asp-controller="AdminDashboard" asp-action="Index" method="get" style="margin: 0;">
            <div class="admin-secondary-btn" style="padding: 0; position: relative;">
                <i class="bi bi-calendar3" style="margin-left: 0.9rem; pointer-events: none;"></i>
                <select name="month" onchange="this.form.submit()" style="border: none; background: transparent; padding: 0.4rem 2rem 0.4rem 0.6rem; outline: none; font-weight: 850; color: #5b351f; cursor: pointer; appearance: none; -webkit-appearance: none; -moz-appearance: none; font-size: 0.75rem;">
                    <option value="">Cả năm @Model.Year</option>
                    @for (var i = 1; i <= 12; i++)
                    {
                        if (Model.Month == i)
                        {
                            <option value="@i" selected>Tháng @i, @Model.Year</option>
                        }
                        else
                        {
                            <option value="@i">Tháng @i, @Model.Year</option>
                        }
                    }
                </select>
                <i class="bi bi-chevron-down" style="font-size: 0.6rem; position: absolute; right: 0.9rem; pointer-events: none;"></i>
                <input type="hidden" name="year" value="@Model.Year" />
            </div>
        </form>
    </div>
</header>

<section class="admin-stats">
    <article class="admin-stat-card">
        <div class="admin-stat-card__top">
            <small>TỔNG DOANH THU</small>
            <span class="admin-stat-card__icon" style="background:#e8dfd8; color:#6d5a4d"><i class="bi bi-cash-stack"></i></span>
        </div>
        <div>
            <strong>@Model.TotalRevenue.ToString("N0") vnđ</strong>
            <span class="admin-stat-card__trend admin-stat-card__trend--up"><i class="bi bi-arrow-up-right"></i> +12.5% so với tháng trước</span>
        </div>
    </article>
    <article class="admin-stat-card">
        <div class="admin-stat-card__top">
            <small>GIÁ TRỊ ĐH TRUNG BÌNH</small>
            <span class="admin-stat-card__icon" style="background:#eee6dd; color:#6d5a4d"><i class="bi bi-receipt"></i></span>
        </div>
        <div>
            <strong>@Model.AverageOrderValue.ToString("N0") vnđ</strong>
            <span class="admin-stat-card__trend admin-stat-card__trend--up"><i class="bi bi-arrow-up-right"></i> +3.2% so với tháng trước</span>
        </div>
    </article>
    <article class="admin-stat-card">
        <div class="admin-stat-card__top">
            <small>TỔNG ĐƠN HÀNG</small>
            <span class="admin-stat-card__icon" style="background:#f1e8e2; color:#6d5a4d"><i class="bi bi-bag"></i></span>
        </div>
        <div>
            <strong>@Model.TotalOrders</strong>
            <span class="admin-stat-card__trend" style="color:#6d5a4d"><i class="bi bi-arrow-right"></i> +0.5% so với tháng trước</span>
        </div>
    </article>
    <article class="admin-stat-card">
        <div class="admin-stat-card__top">
            <small>SẢN PHẨM ĐÃ BÁN</small>
            <span class="admin-stat-card__icon" style="background:#e8dfd8; color:#6d5a4d"><i class="bi bi-box"></i></span>
        </div>
        <div>
            <strong>@Model.TotalProductsSold</strong>
            <span class="admin-stat-card__trend admin-stat-card__trend--up"><i class="bi bi-arrow-up-right"></i> +4.2% so với tháng trước</span>
        </div>
    </article>
</section>

<section class="admin-dashboard-layout">
    <article class="admin-panel">
        <div class="admin-panel__header">
            <small style="font-weight: 800; color: #4e3a2f; letter-spacing: .05em;">DOANH THU THEO THỜI GIAN</small>
            <div style="display:flex; border: 1px solid #d8c4b7; border-radius: 4px; overflow: hidden;">
                <button style="padding: .3rem .8rem; border:none; background: #fbf4ef; font-size:.75rem; font-weight:700; color:#5b351f;">Ngày</button>
                <button style="padding: .3rem .8rem; border:none; border-left: 1px solid #d8c4b7; background: #fff; font-size:.75rem; font-weight:600; color:#6d5a4d;">Tháng</button>
            </div>
        </div>
        <div style="padding: 1.5rem; height: 340px;">
            <div class="admin-revenue-bars">
                @if (Model.RevenueByDay.Count == 0)
                {
                    <div class="admin-empty-state">
                        <i class="bi bi-bar-chart"></i>
                        <span>Không có dữ liệu doanh thu cho kỳ này.</span>
                    </div>
                }
                @foreach (var item in Model.RevenueByDay)
                {
                    var height = maxRevenue <= 0 ? 4 : Math.Max(8, (int)(item.Revenue / maxRevenue * 250));
                    <div class="admin-revenue-bar" title="@item.Date.ToString("dd/MM"): @item.Revenue.ToString("N0") vnđ">
                        <span style="height:@(height)px"></span>
                    </div>
                }
            </div>
        </div>
    </article>

    <aside class="admin-panel">
        <div class="admin-panel__header" style="border-bottom:none">
            <small style="font-weight: 800; color: #4e3a2f; letter-spacing: .05em;">SẢN PHẨM BÁN CHẠY NHẤT</small>
        </div>
        <div style="padding: 0 1.2rem 1.2rem;">
            @if(!Model.TopProducts.Any())
            {
                <div style="color:#6d5a4d; font-size:.85rem; text-align:center; padding: 2rem 0;">Chưa có dữ liệu.</div>
            }
            else
            {
                var maxQty = Model.TopProducts.Max(p => p.Quantity);
                var colors = new[] { "#5b351f", "#5b351f", "#c8a98a", "#d7b493", "#e6ddd8", "#eee2dc" };
                var idx = 0;
                foreach (var prod in Model.TopProducts)
                {
                    var pct = maxQty == 0 ? 0 : (prod.Quantity * 100.0) / maxQty;
                    var color = colors[Math.Min(idx, colors.Length - 1)];
                    <div style="margin-bottom: 1.2rem;">
                        <div style="display:flex; justify-content:space-between; margin-bottom:.3rem; font-size:.8rem; font-weight:700; color:#231a15">
                            <span>@prod.ProductName</span>
                            <span style="color:#6d5a4d;">@prod.Quantity sản phẩm</span>
                        </div>
                        <div style="width:100%; height:6px; background:#eee2dc; border-radius:999px;">
                            <div style="width:@((int)pct)%; height:100%; background:@color; border-radius:999px;"></div>
                        </div>
                    </div>
                    idx++;
                }
            }
        </div>
    </aside>
</section>

<section class="admin-panel" style="margin-top: 1.5rem;">
    <div class="admin-panel__header">
        <small style="font-weight: 800; color: #4e3a2f; letter-spacing: .05em;">HÓA ĐƠN GẦN ĐÂY</small>
        <a asp-controller="AdminHoaDon" asp-action="Index" class="admin-view-all">Xem tất cả</a>
    </div>
    <div class="admin-product-table">
        <div class="admin-product-table__head" style="grid-template-columns: minmax(150px, 1fr) 150px 200px;">
            <span>Mã hóa đơn</span>
            <span>Tổng tiền</span>
            <span>Thanh toán lúc</span>
        </div>
        @if (!Model.RecentInvoices.Any())
        {
            <div style="padding: 2rem; text-align: center; color: #6d5a4d; font-size: .85rem;">Chưa có hóa đơn nào</div>
        }
        else
        {
            foreach (var inv in Model.RecentInvoices)
            {
                <div class="admin-product-table__row" style="grid-template-columns: minmax(150px, 1fr) 150px 200px;">
                    <div>
                        <strong style="display:block; font-size:.85rem; color:#231a15;">@inv.InvoiceCode</strong>
                    </div>
                    <div style="font-size:.85rem; font-weight:700; color:#231a15;">@inv.TotalAmount.ToString("N0") vnđ</div>
                    <div style="font-size:.8rem; color:#6d5a4d;">@inv.PaidAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            }
        }
    </div>
</section>
