@model BanCaPheNuocGiaiKhat.Models.CategoryListViewModel
@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "_AdminLayout";
}

<header class="admin-topbar" style="margin-bottom: 2rem;">
    <div>
        <p class="admin-kicker">MANAGE CATALOG</p>
        <h1>Categories</h1>
    </div>
    
    <a asp-action="Create" class="admin-btn" style="background:var(--coffee-darkest); color:#fff; text-decoration:none; padding: .6rem 1.2rem; border-radius:4px; font-weight:700; font-size:.85rem; display:flex; align-items:center; gap:.5rem;">
        <i class="bi bi-plus-lg"></i> THÊM DANH MỤC
    </a>
</header>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="font-size: .88rem; font-weight: 600; padding: .75rem 1rem;">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="font-size: .88rem; font-weight: 600; padding: .75rem 1rem; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;">@TempData["Error"]</div>
}

<section class="admin-orders-layout" style="display:block;">
    <div class="admin-panel">
        <div class="admin-panel__header">
            <small style="font-weight: 800; color: #4e3a2f; letter-spacing: .05em;">ALL CATEGORIES</small>
            <form method="get" style="display:flex; gap: .5rem; align-items:center;">
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Tìm tên danh mục..." style="padding: .4rem .6rem; border: 1px solid #d8c4b7; border-radius: 4px; font-size: .8rem; outline: none;" />
                <button type="submit" style="padding: .4rem .8rem; border:none; background:#4e3a2f; color:#fff; border-radius:4px; font-weight:600; font-size:.8rem; cursor:pointer;">Lọc</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-action="Index" style="font-size:.8rem; color:#888; text-decoration:none;">Xóa lọc</a>
                }
            </form>
        </div>
        
        <div class="admin-product-table">
            <div class="admin-product-table__head" style="grid-template-columns: 80px minmax(150px, 1fr) minmax(150px, 1fr) 100px 100px;">
                <span>ID</span>
                <span>Tên danh mục</span>
                <span>Danh mục cha</span>
                <span style="text-align:center;">Sản phẩm</span>
                <span style="text-align: right;">Hành động</span>
            </div>
            
            @if (!Model.Categories.Any())
            {
                <div style="padding: 3rem; text-align: center; color: #6d5a4d; font-size: .85rem;">Không tìm thấy danh mục nào.</div>
            }
            else
            {
                foreach (var cat in Model.Categories)
                {
                    <div class="admin-product-table__row" style="grid-template-columns: 80px minmax(150px, 1fr) minmax(150px, 1fr) 100px 100px; align-items:center;">
                        <div><span style="font-weight:600; color:#888;">#@cat.CategoryId</span></div>
                        <div style="font-weight:700; color:#231a15;">@cat.Name</div>
                        <div style="font-size:.85rem; color:#6d5a4d;">@(cat.ParentName ?? "—")</div>
                        <div style="text-align:center;">
                            <span style="background:#e9e2db; color:#4e3a2f; padding:.2rem .6rem; border-radius:20px; font-size:.75rem; font-weight:700;">@cat.ProductCount</span>
                        </div>
                        <div style="display:flex; justify-content:flex-end; gap:.5rem;">
                            <a asp-action="Edit" asp-route-id="@cat.CategoryId" style="color:#007bff; text-decoration:none; font-size:.9rem;"><i class="bi bi-pencil-square"></i></a>
                            <form asp-action="Delete" asp-route-id="@cat.CategoryId" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này?');">
                                <button type="submit" style="background:none; border:none; color:#dc3545; cursor:pointer; font-size:.9rem; padding:0;"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
        
        @if (Model.TotalPages > 1)
        {
            <div style="padding: 1rem 1.5rem; display:flex; gap:.5rem; justify-content:center; border-top: 1px solid #eee6de;">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <span style="display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; background:#4e3a2f; color:#fff; border-radius:4px; font-size:.85rem; font-weight:700;">@i</span>
                    }
                    else
                    {
                        <a asp-action="Index" asp-route-page="@i" asp-route-search="@Model.SearchTerm" style="display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; background:#f4f0ec; color:#4e3a2f; text-decoration:none; border-radius:4px; font-size:.85rem; font-weight:600;">@i</a>
                    }
                }
            </div>
        }
    </div>
</section>
