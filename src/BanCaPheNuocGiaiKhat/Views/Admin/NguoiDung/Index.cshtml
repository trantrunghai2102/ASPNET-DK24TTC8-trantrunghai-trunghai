@model BanCaPheNuocGiaiKhat.Models.UserListViewModel
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<header class="admin-topbar">
    <div>
        <p class="admin-kicker">USER MANAGEMENT</p>
        <h1>System Users & Customers</h1>
    </div>
</header>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="font-size: .88rem; font-weight: 600; padding: .75rem 1rem; margin-bottom: 1.5rem;">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="font-size: .88rem; font-weight: 600; padding: .75rem 1rem; margin-bottom: 1.5rem;">@TempData["Error"]</div>
}

<section class="admin-panel">
    <div class="admin-panel__header">
        <small style="font-weight: 800; color: #4e3a2f; letter-spacing: .05em;">FILTER & SEARCH</small>
        <form method="get" style="display:flex; align-items:center; gap: 0.75rem; flex-wrap: wrap;">
            <select name="roleId" onchange="this.form.submit()" style="padding:.4rem .8rem; border:1px solid #d8c4b7; border-radius:4px; font-size:.8rem; outline:none; background:#fff;">
                <option value="">-- All Roles --</option>
                @foreach (var role in Model.Roles)
                {
                    <option value="@role.RoleId" selected="@(Model.SelectedRoleId == role.RoleId ? "selected" : null)">@role.RoleName.ToUpper()</option>
                }
            </select>
            <input type="text" name="search" value="@Model.SearchQuery" placeholder="Search by name, email, phone..." style="padding:.4rem .8rem; border:1px solid #d8c4b7; border-radius:4px; font-size:.8rem; outline:none; min-width:250px;">
            <button type="submit" class="admin-secondary-btn" style="padding: 0.4rem 1rem; font-size: 0.8rem; border-radius: 4px;">Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchQuery) || Model.SelectedRoleId.HasValue)
            {
                <a asp-action="Index" class="btn btn-sm btn-link" style="color: #6d5a4d; font-size: 0.8rem; text-decoration: none;">Clear Filters</a>
            }
        </form>
    </div>
    
    <div class="admin-product-table">
        <!-- 7-column layout: Avatar+User, Contact, Role, Status, Created At, Last Login, Actions -->
        <div class="admin-product-table__head" style="grid-template-columns: minmax(220px, 1.2fr) minmax(130px, 0.8fr) 140px 100px 110px 110px 150px;">
            <span>User</span>
            <span>Phone</span>
            <span>Role</span>
            <span>Status</span>
            <span>Created At</span>
            <span>Last Login</span>
            <span style="text-align: right;">Actions</span>
        </div>
        
        @if (!Model.Users.Any())
        {
            <div style="padding: 3rem; text-align: center; color: #6d5a4d; font-size: .85rem;">
                No users found matching the query.
            </div>
        }
        else
        {
            foreach (var u in Model.Users)
            {
                <div class="admin-product-table__row" style="grid-template-columns: minmax(220px, 1.2fr) minmax(130px, 0.8fr) 140px 100px 110px 110px 150px; align-items:center;">
                    <!-- User (Avatar + Name & Email) -->
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <img src="https://ui-avatars.com/api/?name=@System.Net.WebUtility.UrlEncode(u.FullName)&background=random&size=40" style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid #eadbd2;" alt="Avatar" />
                        <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            <strong style="display:block; font-size:.88rem; color:#231a15;">@u.FullName</strong>
                            <small style="color:#6d5a4d; font-size:.75rem;">@u.Email</small>
                        </div>
                    </div>
                    
                    <!-- Phone -->
                    <div style="font-size:.8rem; color:#231a15;">@(string.IsNullOrEmpty(u.Phone) ? "—" : u.Phone)</div>
                    
                    <!-- Role Dropdown -->
                    <div>
                        <form asp-action="UpdateRole" method="post" style="display: inline-flex; align-items: center;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserId" />
                            <select name="roleId" onchange="this.form.submit()" style="padding: 0.3rem 0.5rem; font-size: 0.75rem; border: 1px solid #eadbd2; border-radius: 6px; background: #fbf6f1; color: #4e3a2f; font-weight: 600; outline: none; cursor: pointer;">
                                @foreach (var r in Model.Roles)
                                {
                                    <option value="@r.RoleId" selected="@(u.RoleId == r.RoleId ? "selected" : null)">@r.RoleName.ToUpper()</option>
                                }
                            </select>
                        </form>
                    </div>
                    
                    <!-- Status Badge -->
                    <div>
                        @if (u.Status == BanCaPheNuocGiaiKhat.Models.Entities.UserStatus.active)
                        {
                            <span class="admin-status admin-status--green">Active</span>
                        }
                        else if (u.Status == BanCaPheNuocGiaiKhat.Models.Entities.UserStatus.locked)
                        {
                            <span class="admin-status admin-status--orange" style="background:#f8d7da; color:#842029;">Locked</span>
                        }
                        else
                        {
                            <span class="admin-status admin-status--orange">Pending</span>
                        }
                    </div>
                    
                    <!-- Created At -->
                    <div style="font-size:.78rem; color:#6d5a4d;">@u.CreatedAt.ToString("dd/MM/yyyy")</div>
                    
                    <!-- Last Login -->
                    <div style="font-size:.78rem; color:#6d5a4d;">@(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm") : "Never")</div>
                    
                    <!-- Action Lock/Unlock -->
                    <div style="text-align: right;">
                        <form asp-action="ToggleStatus" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserId" />
                            @if (u.Status == BanCaPheNuocGiaiKhat.Models.Entities.UserStatus.active)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 0.72rem; padding: 0.25rem 0.5rem; border-radius: 6px; font-weight: 600;" title="Khóa tài khoản">
                                    <i class="bi bi-lock-fill"></i> LOCK
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success" style="font-size: 0.72rem; padding: 0.25rem 0.5rem; border-radius: 6px; font-weight: 600;" title="Mở khóa tài khoản">
                                    <i class="bi bi-unlock-fill"></i> UNLOCK
                                </button>
                            }
                        </form>
                    </div>
                </div>
            }
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div style="padding: 1rem 1.5rem; display:flex; gap:.5rem; justify-content:center; border-top: 1px solid #eee6de; margin-top: auto;">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.CurrentPage)
                {
                    <span style="display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; background:#4e3a2f; color:#fff; border-radius:4px; font-size:.85rem; font-weight:700;">@i</span>
                }
                else
                {
                    <a asp-action="Index" asp-route-page="@i" asp-route-search="@Model.SearchQuery" asp-route-roleId="@Model.SelectedRoleId" style="display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; background:#f4f0ec; color:#4e3a2f; text-decoration:none; border-radius:4px; font-size:.85rem; font-weight:600;">@i</a>
                }
            }
        </div>
    }
</section>
