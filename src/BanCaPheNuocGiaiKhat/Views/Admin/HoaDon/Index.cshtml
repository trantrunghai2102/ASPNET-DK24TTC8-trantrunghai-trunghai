@model BanCaPheNuocGiaiKhat.Models.DanhSachHoaDonViewModel
@{
    ViewData["Title"] = "Quản lý hóa đơn";
}

<header class="admin-topbar" style="margin-bottom: 2rem;">
    <div>
        <p class="admin-kicker">QUẢN LÝ BÁN HÀNG</p>
        <h1>Quản lý đơn hàng</h1>
    </div>
</header>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="font-size: .88rem; font-weight: 600; padding: .75rem 1rem;">@TempData["Success"]</div>
}

<section class="admin-orders-layout">
    <div class="admin-panel">
        <div class="admin-panel__header">
            <small style="font-weight: 800; color: #4e3a2f; letter-spacing: .05em;">TẤT CẢ ĐƠN HÀNG</small>
            <form method="get" style="display:flex; gap: .5rem; align-items:center;">
                <select name="type" onchange="this.form.submit()" style="padding: .4rem .6rem; border: 1px solid #d8c4b7; border-radius: 4px; background: #fff; font-size: .8rem; font-weight: 600; color: #4e3a2f; outline: none; cursor: pointer;">
                    <option value="">Tất cả loại đơn</option>
                    @if (Model.FilterType == "instore") { <option value="instore" selected>Tại quầy (POS)</option> } else { <option value="instore">Tại quầy (POS)</option> }
                    @if (Model.FilterType == "online") { <option value="online" selected>Trực tuyến (Online)</option> } else { <option value="online">Trực tuyến (Online)</option> }
                </select>
            </form>
        </div>
        
        <div class="admin-product-table">
            <div class="admin-product-table__head" style="grid-template-columns: 110px 100px 110px 130px minmax(100px, 1fr) 100px;">
                <span>Mã đơn</span>
                <span>Loại đơn</span>
                <span>Trạng thái</span>
                <span>Thời gian</span>
                <span>Nhân viên</span>
                <span style="text-align: right;">Tổng tiền</span>
            </div>
            
            @if (!Model.Invoices.Any())
            {
                <div style="padding: 3rem; text-align: center; color: #6d5a4d; font-size: .85rem;">Chưa có đơn hàng nào.</div>
            }
            else
            {
                foreach (var hd in Model.Invoices)
                {
                    <div class="admin-product-table__row" style="grid-template-columns: 110px 100px 110px 130px minmax(100px, 1fr) 100px;">
                        <div><a asp-controller="AdminHoaDon" asp-action="ChiTiet" asp-route-id="@hd.OrderId" class="admin-status" style="text-decoration:none; color:inherit; border-bottom: 1px dashed currentColor;" title="Xem chi tiết">@hd.InvoiceCode</a></div>
                        <div style="font-size:.8rem; color:#6d5a4d;">
                            @if (hd.OrderType?.ToLower() == "online") { <span style="color:#007bff;font-weight:600">Online</span> } else { <span style="color:#28a745;font-weight:600">POS</span> }
                        </div>
                        <div style="font-size:.8rem;">
                            @switch (hd.Status) {
                                case "pending": <span style="color:#ffc107;font-weight:600">Chờ xử lý</span>; break;
                                case "processing": <span style="color:#17a2b8;font-weight:600">Đang xử lý</span>; break;
                                case "shipping": <span style="color:#007bff;font-weight:600">Đang giao</span>; break;
                                case "delivered": <span style="color:#28a745;font-weight:600">Đã giao</span>; break;
                                case "paid": <span style="color:#28a745;font-weight:600">Hoàn tất</span>; break;
                                case "completed": <span style="color:#28a745;font-weight:600">Hoàn tất</span>; break;
                                case "cancelled": <span style="color:#dc3545;font-weight:600">Đã hủy</span>; break;
                                default: <span style="font-weight:600;color:#6d5a4d">@hd.Status</span>; break;
                            }
                        </div>
                        <div style="font-size:.8rem; font-weight:600; color:#231a15;">@hd.Date.ToLocalTime().ToString("MMM dd, HH:mm")</div>
                        <div style="font-size:.8rem; color:#6d5a4d;">@(hd.StaffName ?? "—")</div>
                        <div style="font-size:.85rem; font-weight:700; color:#231a15; text-align: right;">@hd.TotalAmount.ToString("N0") vnd</div>
                    </div>
                }
            }
        </div>
        @if (Model.TotalPages > 1)
        {
            <div style="padding: 1rem 1.5rem; display:flex; gap:.5rem; justify-content:center; border-top: 1px solid #eee6de;">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <span style="display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; background:#4e3a2f; color:#fff; border-radius:4px; font-size:.85rem; font-weight:700;">@i</span>
                    }
                    else
                    {
                        <a asp-action="Index" asp-route-page="@i" asp-route-type="@Model.FilterType" style="display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; background:#f4f0ec; color:#4e3a2f; text-decoration:none; border-radius:4px; font-size:.85rem; font-weight:600;">@i</a>
                    }
                }
            </div>
        }
    </div>

    <div>
        <div class="admin-panel" style="margin-bottom: 1.5rem;">
            <div class="admin-panel__header" style="border-bottom:none">
                <small style="font-weight: 800; color: #4e3a2f; letter-spacing: .05em;">THỐNG KÊ ĐƠN HÀNG</small>
            </div>
            <div style="padding: 0 1.2rem 1.2rem;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.8rem;">
                    <div style="display:flex; align-items:center; gap:.5rem;">
                        <span style="width:10px; height:10px; border-radius:50%; background:#dcebf0;"></span>
                        <span style="font-size:.8rem; font-weight:600; color:#231a15">Chờ xử lý</span>
                    </div>
                    <strong style="font-size:.9rem; color:#231a15">@Model.PendingOrders</strong>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.8rem;">
                    <div style="display:flex; align-items:center; gap:.5rem;">
                        <span style="width:10px; height:10px; border-radius:50%; background:#f1e6d8;"></span>
                        <span style="font-size:.8rem; font-weight:600; color:#231a15">Đang xử lý</span>
                    </div>
                    <strong style="font-size:.9rem; color:#231a15">@Model.ProcessingOrders</strong>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div style="display:flex; align-items:center; gap:.5rem;">
                        <span style="width:10px; height:10px; border-radius:50%; background:#e2efd9;"></span>
                        <span style="font-size:.8rem; font-weight:600; color:#231a15">Hoàn tất</span>
                    </div>
                    <strong style="font-size:.9rem; color:#231a15">@Model.CompletedOrders</strong>
                </div>
            </div>
        </div>

        <div class="admin-panel">
            <div class="admin-panel__header" style="border-bottom:none">
                <small style="font-weight: 800; color: #4e3a2f; letter-spacing: .05em;">HOẠT ĐỘNG GẦN ĐÂY</small>
            </div>
            <div class="admin-activity-list">
                @foreach (var hd in Model.Invoices.Take(4))
                {
                    <div class="admin-activity-item">
                        <div class="admin-activity-item__icon" style="background:#e2efd9; color:#41652e"><i class="bi bi-check-lg"></i></div>
                        <div class="admin-activity-item__content">
                            <p>Đơn hàng @hd.InvoiceCode đã cập nhật</p>
                            <small>@hd.Date.ToLocalTime().ToString("MMM dd, yyyy - HH:mm")</small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>