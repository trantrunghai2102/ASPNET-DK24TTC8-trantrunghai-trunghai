@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<section class="auth-showcase">
    <div class="auth-card">
        <div class="auth-visual" aria-hidden="true"></div>

        <div class="auth-entry-panel">
            <div class="brand-mark">☕</div>
            <h1>TheDrinkVN</h1>
            <p class="auth-entry-subtitle">Start your coffee journey with us.</p>

            <div class="auth-tabs" role="tablist" aria-label="Auth">
                <a asp-action="Login" class="auth-tab">Login</a>
                <a asp-action="Register" class="auth-tab active">Create Account</a>
            </div>

            <form asp-action="Register" method="post" class="auth-entry-form auth-entry-form-register">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                <div class="field-grid">
                    <div class="field-block">
                        <label asp-for="FullName">Full Name</label>
                        <input asp-for="FullName" placeholder="Nguyen Van A" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="field-block">
                        <label asp-for="Phone">Phone</label>
                        <input asp-for="Phone" placeholder="0901234567" autocomplete="tel" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="field-block">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" placeholder="you@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="field-grid">
                    <div class="field-block">
                        <label asp-for="Username">Username</label>
                        <input asp-for="Username" placeholder="thedrinkvn" autocomplete="username" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="field-block">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>

                <div class="field-block">
                    <label asp-for="Role">Role</label>
                    <select asp-for="Role">
                        <option value="@UserRoles.Customer">Customer</option>
                        <option value="@UserRoles.Staff">Staff</option>
                        <option value="@UserRoles.Admin">Admin</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-entry-submit">CREATE ACCOUNT</button>
            </form>

            <div class="social-divider"><span>OR CONTINUE WITH</span></div>
            <div class="social-stack">
                <button type="button" class="social-button">
                    <img src="~/images/google.png" alt="" class="social-logo" />
                    <span>Google</span>
                </button>
                <button type="button" class="social-button">
                    <img src="~/images/facebook.png" alt="" class="social-logo" />
                    <span>Facebook</span>
                </button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
