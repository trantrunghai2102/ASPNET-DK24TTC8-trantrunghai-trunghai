@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<section class="auth-showcase">
    <div class="auth-card">
        <!-- LEFT: coffee image -->
        <div class="auth-visual" aria-hidden="true"></div>

        <!-- RIGHT: form -->
        <div class="auth-entry-panel">
            <div class="brand-mark" aria-hidden="true">☕</div>
            <h1>TheDrinkVN</h1>
            <p class="auth-entry-subtitle">Bắt đầu hành trình cà phê của bạn cùng chúng tôi.</p>

            <div class="auth-tabs" role="tablist" aria-label="Authentication mode">
                <a asp-action="Login" class="auth-tab" role="tab" aria-selected="false">Đăng nhập</a>
                <a asp-action="Register" class="auth-tab active" role="tab" aria-selected="true">Tạo tài khoản</a>
            </div>

            <form asp-action="Register" method="post" class="auth-entry-form auth-entry-form-register" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small" style="margin-bottom:.75rem"></div>

                <div class="field-grid">
                    <div class="field-block">
                        <label asp-for="FullName">Họ và tên</label>
                        <input asp-for="FullName" placeholder="Nguyễn Văn A" autocomplete="name" id="reg-fullname" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="field-block">
                        <label asp-for="Phone">Số điện thoại</label>
                        <input asp-for="Phone" placeholder="0901234567" autocomplete="tel" id="reg-phone" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="field-block">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" placeholder="bạn@example.com" autocomplete="email" id="reg-email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="field-block">
                    <label asp-for="Password">Mật khẩu</label>
                    <div style="position:relative;">
                        <input asp-for="Password" placeholder="••••••••" autocomplete="new-password" id="reg-password" style="padding-right:2.75rem;" />
                        <button type="button" onclick="togglePwd('reg-password',this)" aria-label="Hiện/ẩn mật khẩu" style="position:absolute;right:.6rem;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-muted);padding:.2rem;line-height:1;">
                            <i class="bi bi-eye" style="font-size:1rem;"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <input type="hidden" asp-for="Role" value="customer" />

                <button type="submit" class="auth-entry-submit" id="reg-submit">TẠO TÀI KHOẢN</button>
            </form>

            <div class="social-divider"><span>HOẶC TIẾP TỤC VỚI</span></div>
            <div class="social-stack">
                <button type="button" class="social-button" id="btn-google-register">
                    <img src="~/images/google.png" alt="" class="social-logo" />
                    <span>Google</span>
                </button>
                <button type="button" class="social-button" id="btn-facebook-register">
                    <img src="~/images/facebook.png" alt="" class="social-logo" />
                    <span>Facebook</span>
                </button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd(id, btn) {
            var inp = document.getElementById(id);
            var hide = inp.type === 'password';
            inp.type = hide ? 'text' : 'password';
            btn.querySelector('i').className = hide ? 'bi bi-eye-slash' : 'bi bi-eye';
        }
        (function () {
            const form = document.querySelector('.auth-entry-form');
            const btn  = document.getElementById('reg-submit');

            if (!form || !btn) return;

            form.addEventListener('submit', function () {
                if ($(form).valid()) {
                    btn.classList.add('loading');
                    btn.textContent = 'ĐANG TẠO TÀI KHOẢN...';
                }
            });

            form.querySelectorAll('input').forEach(function (input) {
                input.addEventListener('input', function () {
                    $(input).valid();
                });
            });
        })();
    </script>
}
