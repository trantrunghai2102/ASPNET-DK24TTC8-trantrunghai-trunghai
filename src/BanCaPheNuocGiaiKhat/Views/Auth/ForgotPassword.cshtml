@model BanCaPheNuocGiaiKhat.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="auth-showcase">
    <div class="auth-card">
        <!-- LEFT: coffee image -->
        <div class="auth-visual" aria-hidden="true"></div>

        <!-- RIGHT: form -->
        <div class="auth-entry-panel">
            <div class="brand-mark" aria-hidden="true">☕</div>
            <h1>TheDrinkVN</h1>
            <p class="auth-entry-subtitle">Lấy lại quyền truy cập vào tài khoản của bạn.</p>

            <div class="auth-tabs" role="tablist" aria-label="Authentication mode">
                <a asp-action="Login" class="auth-tab" role="tab" aria-selected="false">Đăng nhập</a>
                <a asp-action="ForgotPassword" class="auth-tab active" role="tab" aria-selected="true">Khôi phục</a>
            </div>

            <form asp-action="ForgotPassword" method="post" class="auth-entry-form" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small" style="margin-bottom:.75rem"></div>

                <div class="field-block">
                    <label asp-for="Email">Email đã đăng ký</label>
                    <input asp-for="Email" placeholder="bạn@example.com" autocomplete="email" id="forgot-email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-entry-submit" id="forgot-submit">GỬI YÊU CẦU</button>
                
                <div style="margin-top: 1rem; text-align: center; font-size: 0.85rem;">
                    <a asp-action="Login" style="color: var(--coffee-mid); font-weight: 600; text-decoration: none;">&larr; Quay lại trang đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form   = document.querySelector('.auth-entry-form');
            const btn    = document.getElementById('forgot-submit');

            if (!form || !btn) return;

            form.addEventListener('submit', function () {
                if ($(form).valid()) {
                    btn.classList.add('loading');
                    btn.textContent = 'ĐANG XỬ LÝ...';
                }
            });

            form.querySelectorAll('input').forEach(function (input) {
                input.addEventListener('input', function () {
                    $(input).valid();
                });
            });
        })();
    </script>
}
