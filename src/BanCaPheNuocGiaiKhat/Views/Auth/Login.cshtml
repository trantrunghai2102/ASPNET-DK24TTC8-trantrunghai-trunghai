@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<section class="auth-showcase">
    <div class="auth-card">
        <div class="auth-visual" aria-hidden="true"></div>

        <div class="auth-entry-panel">
            <div class="brand-mark">☕</div>
            <h1>TheDrinkVN</h1>
            <p class="auth-entry-subtitle">Welcome back to your coffee journey.</p>

            <div class="auth-tabs" role="tablist" aria-label="Auth">
                <a asp-action="Login" class="auth-tab active">Login</a>
                <a asp-action="Register" class="auth-tab">Create Account</a>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" class="auth-entry-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                <div class="field-block">
                    <label asp-for="LoginName">Username or Email</label>
                    <input asp-for="LoginName" placeholder="you@example.com" autocomplete="username" />
                    <span asp-validation-for="LoginName" class="text-danger small"></span>
                </div>

                <div class="field-block">
                    <div class="label-row">
                        <label asp-for="Password">Password</label>
                        <a href="#" aria-disabled="true">Forgot password?</a>
                    </div>
                    <input asp-for="Password" placeholder="••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <label class="remember-row">
                    <input asp-for="RememberMe" />
                    <span>Remember me</span>
                </label>

                <button type="submit" class="auth-entry-submit">SIGN IN</button>
            </form>

            <div class="social-divider"><span>OR CONTINUE WITH</span></div>
            <div class="social-stack">
                <button type="button" class="social-button">
                    <img src="~/images/google.png" alt="" class="social-logo" />
                    <span>Google</span>
                </button>
                <button type="button" class="social-button">
                    <img src="~/images/facebook.png" alt="" class="social-logo" />
                    <span>Facebook</span>
                </button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
