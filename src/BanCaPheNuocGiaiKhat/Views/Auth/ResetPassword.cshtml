@model BanCaPheNuocGiaiKhat.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="auth-showcase">
    <div class="auth-card">
        <!-- LEFT: coffee image -->
        <div class="auth-visual" aria-hidden="true"></div>

        <!-- RIGHT: form -->
        <div class="auth-entry-panel">
            <div class="brand-mark" aria-hidden="true">☕</div>
            <h1>TheDrinkVN</h1>
            <p class="auth-entry-subtitle">Tạo mật khẩu mới cho tài khoản của bạn.</p>

            <form asp-action="ResetPassword" method="post" class="auth-entry-form" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small" style="margin-bottom:.75rem"></div>

                <input type="hidden" asp-for="Email" />

                <div class="field-block">
                    <label asp-for="NewPassword">Mật khẩu mới</label>
                    <div style="position:relative;">
                        <input asp-for="NewPassword" placeholder="••••••••" id="reset-password" style="padding-right:2.75rem;" />
                        <button type="button" onclick="togglePwd('reset-password',this)" aria-label="Hiện/ẩn mật khẩu" style="position:absolute;right:.6rem;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-muted);padding:.2rem;line-height:1;">
                            <i class="bi bi-eye" style="font-size:1rem;"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="field-block">
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                    <div style="position:relative;">
                        <input asp-for="ConfirmPassword" placeholder="••••••••" id="reset-confirm" style="padding-right:2.75rem;" />
                        <button type="button" onclick="togglePwd('reset-confirm',this)" aria-label="Hiện/ẩn mật khẩu" style="position:absolute;right:.6rem;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-muted);padding:.2rem;line-height:1;">
                            <i class="bi bi-eye" style="font-size:1rem;"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-entry-submit" id="reset-submit">ĐỔI MẬT KHẨU</button>
                
                <div style="margin-top: 1rem; text-align: center; font-size: 0.85rem;">
                    <a asp-action="Login" style="color: var(--coffee-mid); font-weight: 600; text-decoration: none;">&larr; Hủy và quay lại đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd(id, btn) {
            var inp = document.getElementById(id);
            var hide = inp.type === 'password';
            inp.type = hide ? 'text' : 'password';
            btn.querySelector('i').className = hide ? 'bi bi-eye-slash' : 'bi bi-eye';
        }
        (function () {
            const form   = document.querySelector('.auth-entry-form');
            const btn    = document.getElementById('reset-submit');

            if (!form || !btn) return;

            form.addEventListener('submit', function () {
                if ($(form).valid()) {
                    btn.classList.add('loading');
                    btn.textContent = 'ĐANG XỬ LÝ...';
                }
            });

            form.querySelectorAll('input').forEach(function (input) {
                input.addEventListener('input', function () {
                    $(input).valid();
                });
            });
        })();
    </script>
}
