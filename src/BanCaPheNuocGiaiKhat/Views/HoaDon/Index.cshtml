@model BanCaPheNuocGiaiKhat.Models.DanhSachHoaDonViewModel
@{
    ViewData["Title"] = "Quản lý hóa đơn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
.hoadon-table-wrap {
    background: var(--cream-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}
.hoadon-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .88rem;
}
.hoadon-table thead { background: var(--cream-deep); }
.hoadon-table th {
    padding: .75rem 1rem;
    text-align: left;
    font-weight: 700;
    font-size: .78rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: .05em;
    border-bottom: 1px solid var(--border);
}
.hoadon-table td {
    padding: .75rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
    vertical-align: middle;
}
.hoadon-table tbody tr:last-child td { border-bottom: none; }
.hoadon-table tbody tr:hover { background: var(--cream-base); }
.invoice-code-badge {
    display: inline-block;
    background: var(--coffee-darkest);
    color: #fff;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .05em;
    padding: .2rem .6rem;
    border-radius: 100px;
}
.amount-cell { font-weight: 700; color: var(--coffee-darkest); }
.action-cell { display: flex; gap: .5rem; align-items: center; }
.btn-view {
    padding: .35rem .75rem;
    background: var(--cream-deep);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: .8rem;
    font-weight: 600;
    text-decoration: none;
    transition: background .15s;
}
.btn-view:hover { background: var(--border); }
.btn-delete {
    padding: .35rem .75rem;
    background: #ffeaea;
    color: #c0392b;
    border: 1px solid #f5c6c6;
    border-radius: var(--radius-md);
    font-size: .8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .15s;
}
.btn-delete:hover { background: #f5c6c6; }
.empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--text-muted);
}
.alert-success {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
    padding: .75rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
    font-size: .88rem;
}
</style>
}

<div class="catalog-page">
    <div class="section-wrapper">
        <header class="catalog-header">
            <h1 class="catalog-title">Quản lý hóa đơn</h1>
            <p class="catalog-subtitle">Danh sách tất cả hóa đơn đã thanh toán.</p>
        </header>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success">@TempData["Success"]</div>
        }

        @if (!Model.Invoices.Any())
        {
            <div class="hoadon-table-wrap">
                <div class="empty-state">
                    <p>Chưa có hóa đơn nào.</p>
                    <a asp-controller="BanHang" asp-action="Index"
                       style="display:inline-block;margin-top:.75rem;font-size:.85rem;font-weight:600;color:var(--coffee-mid);">
                        Bắt đầu bán hàng →
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="hoadon-table-wrap">
                <table class="hoadon-table">
                    <thead>
                        <tr>
                            <th>Mã hóa đơn</th>
                            <th>Thời gian</th>
                            <th>Tổng tiền</th>
                            <th>Nhân viên</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hd in Model.Invoices)
                        {
                            <tr>
                                <td><span class="invoice-code-badge">@hd.InvoiceCode</span></td>
                                <td>@hd.PaidAt.ToLocalTime().ToString("HH:mm — dd/MM/yyyy")</td>
                                <td class="amount-cell">@hd.TotalAmount.ToString("N3") vnđ</td>
                                <td>@(hd.StaffName ?? "—")</td>
                                <td>
                                    <div class="action-cell">
                                        <a asp-controller="HoaDon" asp-action="ChiTiet"
                                           asp-route-id="@hd.InvoiceId" class="btn-view">Xem</a>
                                        <form method="post"
                                              asp-controller="HoaDon" asp-action="Xoa"
                                              asp-route-id="@hd.InvoiceId"
                                              onsubmit="return confirm('Xóa hóa đơn @hd.InvoiceCode?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-delete">Xóa</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div style="display:flex;justify-content:center;gap:.4rem;margin-top:1.5rem;flex-wrap:wrap;">
                @if (Model.CurrentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                       style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--cream-white);color:var(--text-primary);text-decoration:none;font-size:.85rem;">‹</a>
                }
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="Index" asp-route-page="@p"
                       style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid @(p == Model.CurrentPage ? "var(--coffee-dark)" : "var(--border)");border-radius:var(--radius-md);background:@(p == Model.CurrentPage ? "var(--coffee-dark)" : "var(--cream-white)");color:@(p == Model.CurrentPage ? "#fff" : "var(--text-primary)");text-decoration:none;font-size:.85rem;font-weight:@(p == Model.CurrentPage ? "700" : "400");">@p</a>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                       style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--cream-white);color:var(--text-primary);text-decoration:none;font-size:.85rem;">›</a>
                }
            </div>
        }
    </div>
</div>